---
import { type CollectionEntry, getEntries, render } from "astro:content";

import JsonLd from "@/components/JsonLd.astro";
import Countdown from "@/components/ui/Countdown.astro";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import FaqList from "@/components/ui/FaqList.astro";
import FirstMarked from "@/components/ui/FirstMarked.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import TitleBlock from "@/components/ui/primitives/TitleBlock.astro";
import Section from "@/components/ui/Section.astro";
import { eventRoutes } from "@/data/events";
import { ogCards } from "@/data/ogCards";
import { programPhotos } from "@/data/programPhotos";
import { nav, programs, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Breadcrumb, event as eventJsonLd, faqPage } from "@/lib/jsonld";
import { absoluteUrl } from "@/lib/links";

interface Props {
  event: CollectionEntry<"events">;
  trail?: readonly Breadcrumb[];
}

const { event, trail = [] } = Astro.props;
const { data } = event;
const { Content } = await render(event);

const theme = data.program === "sc2" ? undefined : data.program;

if (data.heroImage !== undefined && data.heroImageAlt === undefined) {
  throw new Error(`events/${event.id}: an entry with a heroImage must also set heroImageAlt.`);
}

const hero =
  data.heroImage !== undefined && data.heroImageAlt !== undefined
    ? { src: data.heroImage, alt: data.heroImageAlt }
    : { src: programPhotos[data.program].image, alt: programPhotos[data.program].alt };

const faqEntries = data.faq === undefined ? [] : await getEntries(data.faq);

// Parallel arrays paired by index; a mismatch would silently drop a label, so it fails the build.
const hintLabels = data.hintLabels ?? [];
const hintUrls = data.hintUrls ?? [];
if (hintUrls.length !== hintLabels.length) {
  throw new Error(
    `events/${event.id}: hintUrls has ${String(hintUrls.length)} entries and hintLabels has ${String(hintLabels.length)}.`,
  );
}

const media = [
  ...(data.teaserUrls ?? []).map((url, index) => ({
    url,
    label: `Season teaser ${String(index + 1)}`,
    icon: "play--filled",
  })),
  ...hintUrls.map((url, index) => ({ url, label: hintLabels[index] ?? "", icon: "link" })),
];

const path = eventRoutes.get(event.id);
if (path === undefined) {
  throw new Error(`events/${event.id} has no route in src/data/events.ts.`);
}
const url = absoluteUrl(path);

const details = [
  { label: "Location", value: data.locationName ?? site.location.name },
  { label: "Address", value: data.locationAddress ?? site.location.workspace },
  {
    label: "Directions",
    value: "Parking and the door to use",
    href: data.directionsUrl ?? site.urls.directions,
  },
];
---

<BaseLayout
  description={data.description}
  og={ogCards.events}
  theme={theme}
  title={data.title}
  trail={[...trail, { name: data.title, path }]}
>
  <Fragment slot="head">
    <JsonLd
      data={eventJsonLd({
        name: data.title,
        description: data.description,
        start: data.start,
        end: data.end,
        locationName: data.locationName,
        locationAddress: data.locationAddress,
        url,
        image: absoluteUrl(hero.src.src),
        registrationUrl: data.registrationUrl,
      })}
    />
    {faqEntries.length > 0 && <JsonLd data={faqPage(faqEntries)} />}
  </Fragment>

  <Hero>
    <HeroImage alt={hero.alt} slot="media" src={hero.src} />

    <Fragment slot="eyebrow">
      <FirstMarked text={programs[data.program].name} />
    </Fragment>
    <Fragment slot="title">{data.title}</Fragment>

    {data.subtitle}

    <Fragment slot="actions">
      <Button href={data.ctaHref} size="lg">
        {data.ctaLabel}
      </Button>
      {data.registrationUrl !== undefined && (
        <Button href={data.registrationUrl} size="lg" variant="secondary">
          Register
        </Button>
      )}
    </Fragment>
  </Hero>

  <Section atmosphere="pool" srTitle="When and where">
    <div class="grid gap-6 md:grid-cols-2 md:items-start">
      <Countdown end={data.end} start={data.start} />
      <TitleBlock fields={details} orientation="stack" />
    </div>
  </Section>

  <Section>
    <div class="prose-copy">
      <Content />
    </div>
  </Section>

  {media.length > 0 && (
    <Section atmosphere="ruler">
      <Fragment slot="title">Teasers and hints</Fragment>

      <ul class="grid gap-3 sm:grid-cols-2">
        {media.map(({ icon, label, url }) => (
          <li>
            <a
              class="flex items-center gap-3 pocket pocket-interactive bg-none px-5 py-4"
              href={url}
              rel="noopener"
            >
              <Icon class="shrink-0 text-primary-bright" name={icon} size={24} />
              <span class="flex-1 font-medium text-body text-foreground">{label}</span>
              <Icon class="shrink-0 text-muted" name="launch" size={20} />
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {faqEntries.length > 0 && (
    <Section atmosphere="band">
      <Fragment slot="title">Frequently asked questions</Fragment>
      <FaqList entries={faqEntries} name="event-faq" />
    </Section>
  )}

  <Section>
    <CtaBanner>
      <Fragment slot="title">Tell us you&rsquo;re interested</Fragment>
      If you can&rsquo;t attend this event, tell us about your interests so we can discuss a visit
      to a regular meeting. Students and prospective mentors are welcome.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={nav.calendar.href} size="lg" slot="actions" variant="secondary">
        See when we meet
      </Button>
    </CtaBanner>
  </Section>
</BaseLayout>
