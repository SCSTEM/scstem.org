---
import type { ComponentProps } from "astro/types";

import type { ProgramKey } from "@/data/site";

import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * A program page is the same site wearing team colors (DESIGN.md §2, D16) — so this is a thin
 * wrapper that sets the theme and nothing else. It replaces legacy's duplicated FRC and FLL
 * layouts, one of which was still named `FRCLayout` while rendering FLL.
 */
type Props = Omit<ComponentProps<typeof BaseLayout>, "theme"> & {
  program: Exclude<ProgramKey, "sc2">;
};

const { program, ...rest } = Astro.props;
---

<BaseLayout {...rest} theme={program}>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
