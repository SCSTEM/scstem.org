---
import type { Placement, SeoProps } from "@/lib/seo";

import Analytics from "@/components/Analytics.astro";
import JsonLd from "@/components/JsonLd.astro";
import Seo from "@/components/Seo.astro";
import DrawingFrame from "@/components/ui/DrawingFrame.astro";
import Footer from "@/components/ui/Footer.astro";
import Navbar from "@/components/ui/Navbar.astro";
import { programs, site } from "@/data/site";
import { breadcrumbs, organization } from "@/lib/jsonld";
import "@/styles/global.css";

type Props = Omit<SeoProps, "noindex"> &
  Placement & {
    register?: "blueprint";
  };

const { trail = [], register, ...seo } = Astro.props;
const { theme } = seo;
const accent = theme === undefined ? undefined : programs[theme].accent;
---

<!doctype html>
<html data-accent={accent} data-register={register} lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="dark" name="color-scheme" />
    <Seo {...seo} />

    <link href={site.icons.favicon} rel="icon" sizes="32x32" />
    <link href={site.icons.svg} rel="icon" type="image/svg+xml" />
    <link href={site.icons.appleTouch} rel="apple-touch-icon" />
    <link href="/site.webmanifest" rel="manifest" />

    <JsonLd data={organization} />
    {trail.length > 0 && <JsonLd data={breadcrumbs(trail)} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      class="sr-only rounded-md bg-primary bg-none px-4 py-2 font-medium text-primary-foreground focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-60"
      data-sheet-inert
      href="#main"
    >
      Skip to content
    </a>
    <Navbar />
    <main class={register === "blueprint" ? "flex-1 drawing-sheet" : "flex-1"} id="main">
      {register === "blueprint" && <DrawingFrame />}
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      // Strokes start drawing when they scroll into view; on page load, below-the-fold marks
      // would finish unseen.
      const marks = document.querySelectorAll(".draw-on, .draw-wipe");
      if (marks.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.replace("is-pending", "is-drawing");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.5 },
        );
        for (const mark of marks) {
          mark.classList.add("is-pending");
          observer.observe(mark);
        }
      }
    </script>
  </body>
</html>
