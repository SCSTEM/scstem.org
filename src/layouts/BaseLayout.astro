---
import type { Placement, SeoProps } from "@/lib/seo";

import Analytics from "@/components/Analytics.astro";
import JsonLd from "@/components/JsonLd.astro";
import Seo from "@/components/Seo.astro";
import Footer from "@/components/ui/Footer.astro";
import Navbar from "@/components/ui/Navbar.astro";
import { programs, site } from "@/data/site";
import { breadcrumbs, organization } from "@/lib/jsonld";
import "@/styles/global.css";

/**
 * The chrome every page shares. SEO correctness is built into the signature rather than left to
 * each page: `title` and `description` are required, so a page cannot ship without them.
 *
 * The props are `Seo`'s, forwarded to it; `theme` names the page's program, whose accent lands on
 * `<html>` as `data-accent` (`src/styles/tokens.css`). `trail` is the page's breadcrumb trail, emitted
 * here so no page hand-writes its own `BreadcrumbList`.
 *
 * Slots: the default slot is the page body; `head` takes per-page structured data.
 */
type Props = Omit<SeoProps, "noindex"> & Placement;

const { trail = [], ...seo } = Astro.props;
const { theme } = seo;
const accent = theme === undefined ? undefined : programs[theme].accent;
---

<!doctype html>
<html data-accent={accent} lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="dark" name="color-scheme" />
    <!-- Every page opens dark; a visitor who chose light keeps it (DESIGN.md §5). Inline and
         blocking on purpose: it sets the finish before first paint, so light mode never flashes
         dark. ModeToggle writes the same key. -->
    <script is:inline>
      try {
        if (localStorage.getItem("sc2-mode") === "light") {
          document.documentElement.dataset.mode = "light";
          document.querySelector('meta[name="color-scheme"]').setAttribute("content", "light");
        }
      } catch {}
    </script>
    <Seo {...seo} />

    <link href={site.icons.favicon} rel="icon" sizes="32x32" />
    <link href={site.icons.svg} rel="icon" type="image/svg+xml" />
    <link href={site.icons.appleTouch} rel="apple-touch-icon" />
    <link href="/site.webmanifest" rel="manifest" />

    <JsonLd data={organization} />
    {trail.length > 0 && <JsonLd data={breadcrumbs(trail)} />}
    <slot name="head" />
  </head>
  <!-- A flex column so `main` absorbs the slack and the footer band reaches the bottom of a
       tall viewport. -->
  <body class="flex min-h-dvh flex-col">
    <a
      class="sr-only rounded-md bg-primary bg-none px-4 py-2 font-medium text-primary-foreground focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-60"
      data-sheet-inert
      href="#main"
    >
      Skip to content
    </a>
    <Navbar />
    <main class="flex-1" id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      // Hand-markup strokes draw on when they come into view (DESIGN.md §6), not on page load,
      // where anything below the fold would finish unseen. Marks already in view animate at once.
      const marks = document.querySelectorAll(".draw-on");
      if (marks.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.replace("is-pending", "is-drawing");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.5 },
        );
        for (const mark of marks) {
          mark.classList.add("is-pending");
          observer.observe(mark);
        }
      }
    </script>
  </body>
</html>
