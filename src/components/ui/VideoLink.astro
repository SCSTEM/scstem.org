---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import { Image } from "astro:assets";

import Icon from "@/components/ui/primitives/Icon.astro";
import { PHOTO_QUALITY } from "@/lib/images";

/**
 * The anchor is the whole frame, so the play button is decorative: `label` names the destination
 * and the poster is `alt=""`.
 */
interface Props extends Omit<HTMLAttributes<"a">, "class" | "href" | "aria-label"> {
  href: string | URL;
  label: string;
  poster: ImageMetadata;
  class?: string;
}

const { href, label, poster, class: className, rel = "noopener", ...attrs } = Astro.props;
---

<a
  aria-label={label}
  class:list={["group relative block media-frame bg-none pb-0", className]}
  href={href}
  rel={rel}
  {...attrs}
>
  <Image
    alt=""
    class="w-full"
    loading="lazy"
    quality={PHOTO_QUALITY}
    sizes="(min-width: 48rem) 48rem, 92vw"
    src={poster}
    width={1024}
    widths={[672, 840, 1024]}
  />
  <span class="absolute inset-0 grid place-items-center bg-background/40">
    <span class="grid size-16 place-items-center rounded-md bg-primary text-primary-foreground transition-transform duration-(--sc2-duration-micro) group-hover:scale-105">
      <Icon name="play--filled" size={32} />
    </span>
  </span>
</a>
