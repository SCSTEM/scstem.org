---
import type { HandVariant } from "@/lib/hand";

import Link from "@/components/ui/primitives/Link.astro";
import SketchArrow from "@/components/ui/primitives/SketchArrow.astro";
import { cn } from "@/lib/cn";

/**
 * A section's next step, written onto the sheet by hand. With a `prompt`, a sketched arrow bridges
 * the typeset question to the handwritten link that answers it, and the link is underlined by hand;
 * without one, the link is circled.
 */
interface Props {
  href: string;
  prompt?: string;
  /** Adjacent instances must use different variants. */
  variant?: HandVariant;
  class?: string;
}

const { href, prompt, variant = 1, class: className } = Astro.props;

const size = "text-h3 leading-snug";
---

<p class={cn("flex flex-wrap items-center gap-x-4 gap-y-1", className)}>
  {prompt === undefined ? (
    <Link around="control" class={size} href={href} mark="oval" variant={variant}>
      <slot />
    </Link>
  ) : (
    <>
      <span class="text-lead">{prompt}</span>
      <span class="flex items-center gap-3">
        <SketchArrow class="h-10 w-12 shrink-0" direction="right" variant={variant} />
        <Link class={size} href={href} mark="underline" variant={variant}>
          <slot />
        </Link>
      </span>
    </>
  )}
</p>
