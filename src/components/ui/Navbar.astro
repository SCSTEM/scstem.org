---
import { Image } from "astro:assets";

import logoLockup from "@/assets/brand/logo-color-full.svg";
import logoMark from "@/assets/brand/logo-color.svg";
import Button from "@/components/ui/primitives/Button.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import { nav, site } from "@/data/site";
import { cn } from "@/lib/cn";

/**
 * Site header (DESIGN.md §5, D26). Sticky on all viewports, condensing after scroll in pure CSS.
 *
 * Identity is the **real lockup**, never a rebuilt gear plus the name in Inter: the full-width
 * color lockup on ≥ md, the square mark alone on mobile. Brand rules forbid substituting "SC2"
 * for the name, and the full name appears in page content (hero and footer) to satisfy them.
 *
 * The Programs entry is a real link to `/programs` with a disclosure *in addition* — never
 * hover-only, so touch and no-JS both get a destination (§5, §9). The panel is a native
 * `popover`, which supplies Esc, light-dismiss and top-layer placement without script (§9's
 * "menus close on Esc"; WCAG 2.2 SC 1.4.13 needs the dismissal).
 *
 * Both viewports project `nav` from `src/data/site.ts`; the desktop/sheet split is the `surfaces`
 * field there, not two hand-written lists.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
/** A section is "current" for its children too, so /programs/frc lights up Programs. */
const inSection = (href: string): boolean => current === href || current.startsWith(`${href}/`);

/**
 * `as const` on the data gives each entry's `surfaces` a literal tuple type, so a direct
 * `.includes("header")` is an error on entries that lack it. Widening through the parameter is
 * what keeps one list readable from both surfaces without a cast.
 */
const onSurface =
  (surface: string) =>
  (link: { readonly surfaces: readonly string[] }): boolean =>
    link.surfaces.includes(surface);

const headerLinks = nav.primary.filter(onSurface("header"));
const sheetLinks = nav.primary.filter(onSurface("sheet"));

const navLink = "ui-link text-small rounded-md px-3 py-2 font-medium";
---

<header
  class={cn(
    "sticky top-0 z-50 border-b border-border",
    "bg-background/95 supports-[backdrop-filter]:bg-background/80 supports-[backdrop-filter]:backdrop-blur",
    className,
  )}
  data-site-header
>
  <nav aria-label="Main" class="container-page flex items-center gap-4">
    <a
      aria-label={`${site.name} — home`}
      class="ui-link flex shrink-0 items-center py-2"
      data-sheet-inert
      href="/"
    >
      <Image
        alt=""
        class="hidden h-10 w-auto origin-left md:block"
        data-header-lockup
        priority
        src={logoLockup}
      />
      <Image alt="" class="h-10 w-auto md:hidden" priority src={logoMark} />
    </a>

    <div class="ml-auto hidden items-center gap-1 md:flex" data-sheet-inert>
      {
        headerLinks.map((link) =>
          link.href === "/programs" ? (
            <div class="relative">
              <span class="flex items-center">
                <a
                  aria-current={inSection(link.href) ? "page" : undefined}
                  class={cn(navLink, "pr-1")}
                  href={link.href}
                >
                  {link.label}
                </a>
                <button
                  aria-label="Show programs"
                  class="text-foreground hover:text-primary-bright grid size-9 place-items-center rounded-md"
                  popovertarget="programs-panel"
                  type="button"
                >
                  <Icon name="chevron-down" size={20} />
                </button>
              </span>
              <div class="pocket absolute top-full left-0 m-0 w-64 p-2" id="programs-panel" popover>
                {nav.programs.map((entry) => (
                  <a
                    aria-current={current === entry.href ? "page" : undefined}
                    class="ui-link hover:bg-card-hover block rounded-md px-3 py-2"
                    href={entry.href}
                  >
                    <span class="text-small block font-medium">{entry.label}</span>
                    <span class="text-small text-muted block">{entry.name}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              aria-current={inSection(link.href) ? "page" : undefined}
              class={navLink}
              href={link.href}
            >
              {link.label}
            </a>
          ),
        )
      }
      <Button class="ml-2" href={nav.cta.href} size="sm">{nav.cta.label}</Button>
    </div>

    <!--
      One state, `aria-expanded`, with CSS deriving the icon swap from it. The icons used to be
      toggled by two element handles found through `data-menu-icon-*`, which `Icon.astro` never
      emitted — so the hamburger never became an X.
    -->
    <button
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
      class="text-foreground ml-auto grid size-11 place-items-center rounded-md md:hidden"
      data-menu-toggle
      type="button"
    >
      <Icon class="menu-icon-open" name="menu-2" size={24} />
      <Icon class="menu-icon-close" name="x" size={24} />
    </button>
  </nav>
</header>

<!--
  Full-height sheet (D26). Nothing is more than two taps away. Opaque, so the page behind it is
  marked `inert` while it is open rather than left in the tab order.
-->
<div class="bg-background fixed inset-0 z-40 md:hidden" data-menu-sheet hidden id="mobile-menu">
  <nav
    aria-label="Mobile"
    class="flex h-full flex-col overflow-y-auto px-4 pt-20 pb-[env(safe-area-inset-bottom)]"
  >
    <ul class="divide-border flex flex-col divide-y">
      {
        sheetLinks.map((link) => (
          <li>
            <a
              aria-current={inSection(link.href) ? "page" : undefined}
              class="ui-link text-h4 flex min-h-14 items-center font-semibold"
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto flex flex-col gap-3 py-6">
      <Button href={nav.cta.href} size="lg">{nav.cta.label}</Button>
      <Button href="/donate" size="lg" variant="outline">Donate</Button>
    </div>
  </nav>
</div>

<style>
  /**
   * Condense after scroll. Scroll-driven animations are progressive: where they are unsupported
   * the header simply keeps its full height, which is the correct fallback.
   *
   * `scale`, not `height`: height is not a compositor property, so animating it relayouts the
   * sticky header and reflows the page below on every scroll frame (DESIGN.md §6 — "only
   * `opacity` and `transform` animate").
   */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-header-lockup] {
        animation: condense-lockup linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 120px;
      }
    }
  }

  @keyframes condense-lockup {
    to {
      scale: 0.8;
    }
  }

  /**
   * The open/closed icon pair, derived from the button's own state.
   *
   * `:global()` on the icon is required: the `<svg>` is rendered by `Icon.astro`, so it carries no
   * `data-astro-cid-*` of this component and a plain descendant selector would be rewritten to
   * demand one and match nothing. The `[data-menu-toggle]` side keeps the scope.
   */
  [data-menu-toggle] :global(.menu-icon-close),
  [data-menu-toggle][aria-expanded="true"] :global(.menu-icon-open) {
    display: none;
  }

  [data-menu-toggle][aria-expanded="true"] :global(.menu-icon-close) {
    display: block;
  }

  /* The scroll lock, likewise: no inline style to leave behind. */
  body:has([data-menu-sheet]:not([hidden])) {
    overflow: hidden;
  }
</style>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const sheet = document.querySelector("[data-menu-sheet]");

  if (toggle instanceof HTMLElement && sheet instanceof HTMLElement) {
    /**
     * The sheet is opaque and covers the page, so everything behind it leaves the tab order and
     * the accessibility tree — otherwise Tab past the last item walks invisible links. `body`
     * cannot be the target: it contains the sheet. Everything in the shell that is not the toggle
     * carries `data-sheet-inert`.
     */
    const behind = document.querySelectorAll("main, footer, [data-sheet-inert]");

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      sheet.hidden = !open;
      for (const element of behind) element.toggleAttribute("inert", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !sheet.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    /**
     * Both the sheet and its toggle are `md:hidden`, so crossing the breakpoint while open would
     * otherwise leave the page scroll-locked and inert with no visible control to undo it.
     */
    const desktop = window.matchMedia("(min-width: 48rem)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
