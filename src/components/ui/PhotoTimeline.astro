---
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";

import Callout from "@/components/ui/primitives/Callout.astro";
import Carousel from "@/components/ui/primitives/Carousel.astro";
import { PHOTO_QUALITY } from "@/lib/images";

/**
 * A run of team photos as a scroll-snap track, oldest first — the "photo groupings as
 * interleaved timeline sections" the about page is built from (DESIGN.md §5).
 *
 * The photos are dense and repeating, so they take the plain `radius-lg` treatment of §7 rather
 * than the 2px `media-frame`, which §2.4 reserves for singular feature media.
 */
type TeamPhoto = CollectionEntry<"frcTeamPhotos"> | CollectionEntry<"fllTeamPhotos">;

interface Props {
  /** Names the track for assistive tech, so two timelines on a page are distinguishable. */
  label: string;
  photos: readonly TeamPhoto[];
  class?: string;
}

const { label, photos, class: className } = Astro.props;
---

<Carousel class={className} itemBasis="42%" label={label}>
  {
    photos.map(({ data }) => (
      <figure>
        <Image
          alt={data.alt}
          class="aspect-video w-full rounded-lg object-cover"
          loading="lazy"
          quality={PHOTO_QUALITY}
          sizes="(min-width: 48rem) 30rem, 92vw"
          src={data.photo}
          width={960}
          widths={[480, 672, 960]}
        />
        {data.caption !== undefined && (
          <Callout as="figcaption" class="mt-3">
            {data.caption}
          </Callout>
        )}
      </figure>
    ))
  }
</Carousel>
