---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import { PHOTO_QUALITY } from "@/lib/images";

/**
 * A competition robot's photo in a `media-frame`, with the season's wordmark in the bottom-right
 * corner where the season had one. The wordmark is decorative (`alt=""`): the photo's alt already
 * names the robot.
 *
 * `span` sets the image sizes for where the figure sits: `full` across the section, `half` in one
 * column of a two-column row. With `href` the frame is the link — reset from the text-link
 * underline — and the default slot carries whatever overlays it, such as the link's label.
 */
interface Props {
  image: ImageMetadata;
  imageAlt: string;
  logo?: ImageMetadata | undefined;
  span: "full" | "half";
  href?: string;
  loading?: "eager" | "lazy";
}

const { image, imageAlt, logo, span, href, loading = "lazy" } = Astro.props;

const photo =
  span === "full"
    ? { sizes: "(min-width: 72rem) 68rem, 92vw", width: 1440, widths: [720, 1080, 1440] }
    : { sizes: "(min-width: 64rem) 34rem, 92vw", width: 1120, widths: [560, 672, 840, 1120] };

const mark =
  span === "full"
    ? {
        class: "absolute right-4 bottom-4 w-24 md:right-8 md:bottom-8 md:w-40",
        width: 320,
        widths: [160, 320],
      }
    : { class: "absolute right-4 bottom-4 w-1/4", width: 280, widths: [140, 280] };

const Frame = href === undefined ? "div" : "a";
---

<Frame
  class:list={["relative media-frame", href !== undefined && "group block bg-none pb-0"]}
  href={href}
>
  <Image
    alt={imageAlt}
    class="w-full"
    loading={loading}
    quality={PHOTO_QUALITY}
    sizes={photo.sizes}
    src={image}
    width={photo.width}
    widths={photo.widths}
  />
  {
    logo !== undefined && (
      <Image
        alt=""
        class={mark.class}
        loading="lazy"
        src={logo}
        width={mark.width}
        widths={mark.widths}
      />
    )
  }
  <slot />
</Frame>
