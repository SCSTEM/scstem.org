---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import Callout from "@/components/ui/primitives/Callout.astro";
import ZoomImage from "@/components/ui/ZoomImage.astro";

/** The wordmark is decorative (`alt=""`): the photo's alt already names the robot. */
interface Props {
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  logo?: ImageMetadata | undefined;
  span: "full" | "half";
  href?: string;
  loading?: "eager" | "lazy";
}

const { image, imageAlt, caption, logo, span, href, loading = "lazy" } = Astro.props;

const photo =
  span === "full"
    ? { sizes: "(min-width: 72rem) 68rem, 92vw", width: 1440, widths: [720, 1080, 1440] }
    : { sizes: "(min-width: 64rem) 34rem, 92vw", width: 1120, widths: [560, 672, 840, 1120] };

const mark =
  span === "full"
    ? {
        class: "absolute right-4 bottom-4 w-24 md:right-8 md:bottom-8 md:w-40",
        width: 320,
        widths: [160, 320],
      }
    : { class: "absolute right-4 bottom-4 w-1/4", width: 280, widths: [140, 280] };

const Frame = href === undefined ? "div" : "a";
---

<figure>
  <Frame
    class:list={["relative media-frame", href !== undefined && "group block bg-none pb-0"]}
    href={href}
  >
    <ZoomImage
      alt={imageAlt}
      class="w-full"
      loading={loading}
      sizes={photo.sizes}
      src={image}
      width={photo.width}
      widths={photo.widths}
      zoom={href === undefined}
    />
    {logo !== undefined && (
      <Image
        alt=""
        class={mark.class}
        loading="lazy"
        src={logo}
        width={mark.width}
        widths={mark.widths}
      />
    )}
    <slot />
  </Frame>
  <Callout as="figcaption" class="mt-3" figure>
    {caption}
  </Callout>
</figure>
