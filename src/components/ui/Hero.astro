---
import { cn } from "@/lib/cn";

/**
 * The page hero (DESIGN.md §5, §7). The media arrives through a slot, so the same component
 * carries a photograph here and a looping video on the pages that have one — only the slotted
 * element changes.
 *
 * Two layouts, one image: below `md` the copy sits on solid ground *underneath* the photo, which
 * fades into the page (§7 — "never gamble on scrims at small sizes"); from `md` up the photo
 * fills the hero and the copy sits on a scrim built from `background`.
 *
 * From `md` up the drafting grid (§2.3) reads over the copy side of the scrim and feathers out
 * before the photo's subject.
 *
 * Without `media` it is the compact header: the same copy on the ground, at `h1` size rather than
 * `display`, for a page whose content has to start above the fold. Both end on the accent rule
 * (§2.2).
 *
 * Slots: `media`, `eyebrow` or `logo` (a lockup image in the eyebrow's place), `title` (wrapped
 * in the `h1`), the default subhead, and `actions`.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const hasMedia = Astro.slots.has("media");
const eyebrow = Astro.slots.has("eyebrow") ? await Astro.slots.render("eyebrow") : undefined;
---

<section class={cn("relative", className)} data-surface="sheet">
  {hasMedia && (
    <div class="hero-media relative aspect-3/2 md:absolute md:inset-0 md:aspect-auto">
      <slot name="media" />
      {/* DESIGN.md §7: opaque at the text edge, ~20% at the far one. The desktop stops are
            placed so the opaque band spans the copy column instead of ending halfway through it.
            The light finish holds solid ground further and eases out more slowly, so the photo
            sits in the aluminum rather than washing the copy out. */}
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-linear-to-b from-transparent from-45% to-background md:bg-linear-to-r md:from-background md:from-35% md:via-background/75 md:via-65% md:to-background/20 md:opacity-92 light:md:from-30% light:md:via-background/85 light:md:via-52% light:md:to-background/30 light:md:opacity-100"
      />
      <div aria-hidden="true" class="absolute inset-0 hidden hero-grid md:block" />
    </div>
  )}

  <div
    class={cn(
      "relative container-page",
      hasMedia ? "section-y md:flex md:min-h-120 md:items-center" : "pt-12 pb-10 md:pt-16 md:pb-12",
    )}
  >
    <div class={hasMedia ? "max-w-2xl" : undefined}>
      {Astro.slots.has("logo") ? (
        <slot name="logo" />
      ) : (
        eyebrow !== undefined && <p class="spec-label text-primary-bright" set:html={eyebrow} />
      )}
      <h1 class={cn("mt-3", hasMedia && "text-display")}>
        <slot name="title" />
      </h1>
      <div class={cn("measure text-lead", hasMedia ? "mt-5 text-foreground" : "mt-4")}>
        <slot />
      </div>
      {Astro.slots.has("actions") && (
        /* One column of full-width buttons below `sm`, so a wrapped pair never stacks at two
             different widths. */
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
          <slot name="actions" />
        </div>
      )}
    </div>
  </div>
</section>

<hr class="accent-rule" />

<style>
  /**
   * The slot takes an `<img>` or a `<video>`, and either has to fill the frame. `:global()`
   * because the element is authored by the caller, so it carries no `data-astro-cid-*` of this
   * component and a plain descendant selector would be rewritten to demand one.
   */
  .hero-media :global(:is(img, video)) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* A blueprint page's photo goes duotone: grayscale under the print's own scrim (DESIGN.md §7). */
  :global([data-register="blueprint"]) .hero-media :global(:is(img, video)) {
    filter: grayscale(1) contrast(1.05);
  }

  /**
   * On the light finish the photo is pulled back a little (DESIGN.md §7); a hero inside a dark
   * island keeps its photo as is. The rule is global as a whole because Astro does not unwrap
   * `:global()` nested inside `:not()`; `.hero-media` exists only in this component.
   */
  :global([data-mode="light"] .hero-media:not([data-mode="dark"] *) :is(img, video)) {
    filter: saturate(0.85) contrast(0.92) brightness(1.04);
  }
</style>
