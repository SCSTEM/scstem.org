---
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";

import Badge from "@/components/ui/primitives/Badge.astro";
import Card from "@/components/ui/primitives/Card.astro";
import CardFooter from "@/components/ui/primitives/CardFooter.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import { cn } from "@/lib/cn";

type Level = CollectionEntry<"sponsors">["data"]["level"];

const tones = {
  Platinum: "platinum",
  Gold: "gold",
  Silver: "silver",
  Bronze: "bronze",
  // Friend sits outside the metals and has no tier color; `muted` is the neutral chip.
  Friend: "muted",
} as const satisfies Record<Level, string>;

interface Props {
  sponsor: CollectionEntry<"sponsors">;
  layout?: "stack" | "feature";
  class?: string;
}

const { sponsor, layout = "stack", class: className } = Astro.props;
const featured = layout === "feature";
const { name, level, logo, url, sub, since } = sponsor.data;
---

<Card
  as="li"
  class={cn("relative flex flex-col", featured && "md:flex-row", className)}
  feature={featured}
  interactive={url !== undefined}
>
  <div
    class={cn(
      "flex flex-1 flex-col items-center justify-center gap-3 p-6",
      featured && "md:px-10 md:py-12",
    )}
  >
    {logo === undefined ? (
      <span class="text-center text-h4 font-semibold text-foreground">{name}</span>
    ) : (
      <Image
        alt={`${name} logo`}
        class={cn(
          "box-content h-20 w-full max-w-56 rounded-md bg-print object-contain p-3",
          featured && "md:h-28 md:max-w-80",
        )}
        loading="lazy"
        src={logo}
        width={448}
        widths={[224, 448]}
      />
    )}
    {sub !== undefined && <p class="text-center text-small text-body">{sub}</p>}
  </div>

  <CardFooter
    class={cn(
      "flex-wrap justify-between",
      featured &&
        "md:w-2/5 md:flex-col md:flex-nowrap md:items-start md:justify-center md:gap-5 md:border-t-0 md:border-l md:px-8",
    )}
  >
    <div>
      <p class={cn("font-semibold text-foreground", featured && "md:text-h4")}>{name}</p>
      {since !== undefined && (
        <p class="mt-1 text-small text-muted">
          Partnering with us since <time datetime={String(since)}>{since}</time>
        </p>
      )}
    </div>

    <div class="flex items-center gap-3">
      <Badge tone={tones[level]}>{level}</Badge>
      {url !== undefined && (
        /* The stretched anchor keeps the whole card clickable while the link keeps one short
           accessible name. */
        <a
          aria-label={`${name} website`}
          class="ui-link after:absolute after:inset-0"
          data-track="outbound_sponsor_click"
          href={url}
          rel="sponsored noopener"
        >
          <Icon name="launch" size={20} />
        </a>
      )}
    </div>
  </CardFooter>
</Card>
