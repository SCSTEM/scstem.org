---
import GridBubble from "@/components/ui/primitives/GridBubble.astro";
import RulerDivider from "@/components/ui/primitives/RulerDivider.astro";
import { cn } from "@/lib/cn";

/**
 * A single-valued `atmosphere` rather than booleans, so the type enforces one device per boundary.
 *
 * `band` makes the section a surface. Every section states its surface in `data-surface`, which
 * the build reads, in document order, to fail any page where two bands touch (the footer is a
 * band too); only Sections, the Hero, and the footer should sit between bands.
 */
interface Props {
  atmosphere?: "none" | "bubble" | "pool" | "pool-neutral" | "ruler" | "band";
  /** Only read with `atmosphere="bubble"`, which requires it. */
  index?: number;
  /** `center` centers the header only; the body places itself. */
  align?: "start" | "center";
  srTitle?: string;
  id?: string;
  class?: string;
}

const { atmosphere = "none", align = "start", index, srTitle, id, class: className } = Astro.props;

if (atmosphere === "bubble" && index === undefined) {
  throw new Error('Section: atmosphere="bubble" needs an `index` for the bubble to show.');
}

if (srTitle !== undefined && Astro.slots.has("title")) {
  throw new Error("Section: pass `srTitle` or a `title` slot, not both.");
}

const hasEyebrow = Astro.slots.has("eyebrow");
const eyebrow = hasEyebrow ? await Astro.slots.render("eyebrow") : undefined;
const hasHeader = hasEyebrow || Astro.slots.has("title") || Astro.slots.has("intro");
---

<section
  class={cn(
    "relative section-y",
    atmosphere === "band" && "band",
    atmosphere === "pool" && "ambient-pool",
    atmosphere === "pool-neutral" && "ambient-pool ambient-pool-neutral",
    className,
  )}
  data-surface={atmosphere === "band" ? "band" : "sheet"}
  id={id}
>
  <div class="container-page">
    {atmosphere === "ruler" && <RulerDivider class="mb-12" />}

    {srTitle !== undefined && <h2 class="sr-only">{srTitle}</h2>}

    {atmosphere === "bubble" && index !== undefined && <GridBubble class="mb-6" value={index} />}

    {hasHeader && (
      <div
        class={cn(
          Astro.slots.has("aside") &&
            "flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12",
          align === "center" && "text-center",
        )}
      >
        <div>
          {eyebrow !== undefined && <p class="spec-label text-primary-bright" set:html={eyebrow} />}
          {Astro.slots.has("title") && (
            <h2 class={hasEyebrow ? "mt-2" : undefined}>
              <slot name="title" />
            </h2>
          )}
          {Astro.slots.has("intro") && (
            <div class={cn("mt-4 measure text-lead", align === "center" && "mx-auto")}>
              <slot name="intro" />
            </div>
          )}
        </div>
        {Astro.slots.has("aside") && (
          <div class="shrink-0">
            <slot name="aside" />
          </div>
        )}
      </div>
    )}

    {Astro.slots.has("default") && (
      <div class={hasHeader ? "mt-10" : undefined}>
        <slot />
      </div>
    )}

    {Astro.slots.has("action") && (
      <div class="mt-12">
        <slot name="action" />
      </div>
    )}
  </div>
</section>
