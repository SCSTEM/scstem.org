---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import FirstMarked from "@/components/ui/FirstMarked.astro";
import Badge from "@/components/ui/primitives/Badge.astro";
import Card from "@/components/ui/primitives/Card.astro";
import CardContent from "@/components/ui/primitives/CardContent.astro";
import CardFooter from "@/components/ui/primitives/CardFooter.astro";
import CardHeader from "@/components/ui/primitives/CardHeader.astro";
import CardTitle from "@/components/ui/primitives/CardTitle.astro";
import FigureTag from "@/components/ui/primitives/FigureTag.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import { cn } from "@/lib/cn";
import { PHOTO_QUALITY } from "@/lib/images";
import { isExternal } from "@/lib/links";

/**
 * The photo is inset rather than bled to the top edge: a full-width image would cover the inset
 * shadow that makes the card read as machined into the page.
 */
interface Props {
  /** Carbon icon name for the plate. Ignored when the card has an `image`. */
  icon?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  badge?: string;
  href?: string;
  /** The footer link's text and accessible name; make it specific. */
  cta?: string;
  /** Feature moments only; dense grids stay plain. */
  feature?: boolean;
  class?: string;
}

const {
  icon,
  image,
  imageAlt,
  imageCaption,
  badge,
  href,
  cta = "Learn more",
  feature = false,
  class: className,
} = Astro.props;

if (image !== undefined && imageAlt === undefined) {
  throw new Error("FeatureCard: an `image` needs an `imageAlt`.");
}

const isExternalLink = href !== undefined && isExternal(href);

if (image === undefined && icon === undefined) {
  throw new Error("FeatureCard: a card needs an `image` or an `icon`.");
}

const plateIcon = image === undefined ? icon : undefined;
---

<Card
  as="article"
  class={cn("relative flex flex-col", href !== undefined && "group", className)}
  feature={feature}
  interactive={href !== undefined}
>
  {image !== undefined && (
    <div class="relative m-4 mb-0">
      <Image
        alt={imageAlt ?? ""}
        class="aspect-16/10 w-full rounded-md object-cover"
        loading="lazy"
        quality={PHOTO_QUALITY}
        sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 45vw, 92vw"
        src={image}
        width={900}
        widths={[400, 672, 768, 900]}
      />
      <FigureTag caption={imageCaption} class="right-2 bottom-2 md:right-3 md:bottom-3" />
    </div>
  )}

  <CardHeader>
    {plateIcon !== undefined && (
      <span class="grid size-9 place-items-center rounded-sm border border-current/40 text-primary-bright">
        <Icon name={plateIcon} size={20} />
      </span>
    )}
    <div class="flex items-start justify-between gap-4">
      <CardTitle>
        <slot name="title" />
      </CardTitle>
      {/* One title line tall, so the chip never sets the row's height and the rule below sits at
          the same depth with or without it. */}
      {badge !== undefined && (
        <span class="flex h-lh shrink-0 items-center text-h4">
          <Badge>{badge}</Badge>
        </span>
      )}
    </div>
    <hr class="mt-3 title-rule" />
  </CardHeader>

  <CardContent class="flex-1">
    <slot />
  </CardContent>

  {href !== undefined && (
    <CardFooter>
      {/* The stretched pseudo-element makes the pocket clickable without nesting the card's content
          in the anchor, so the link keeps one short accessible name. */}
      <a
        class="ui-link text-small font-medium after:absolute after:inset-0"
        href={href}
        rel={isExternalLink ? "noopener" : undefined}
      >
        <FirstMarked text={cta} />
      </a>
      <Icon
        class="text-primary-bright transition-transform duration-(--sc2-duration-micro) ease-(--sc2-ease-toggle) motion-safe:group-focus-within:translate-x-0.5 motion-safe:group-hover:translate-x-0.5"
        name={isExternalLink ? "launch" : "arrow--right"}
        size={20}
      />
    </CardFooter>
  )}
</Card>
