---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import { PHOTO_QUALITY } from "@/lib/images";

/** The LCP element on every page that has a hero, hence eager loading and high fetch priority. */
interface Props {
  alt: string;
  src: ImageMetadata;
}

const { alt, src } = Astro.props;
---

<Image
  alt={alt}
  fetchpriority="high"
  loading="eager"
  quality={PHOTO_QUALITY}
  sizes="100vw"
  src={src}
  width={1920}
  widths={[640, 768, 960, 1280, 1920]}
/>
