---
import FirstMark from "@/components/ui/FirstMark.astro";

/**
 * A plain string from content — a game, an event, an award — with every "FIRST" in it set as the
 * word mark, since frontmatter can only carry the bare word.
 */
interface Props {
  text: string;
}

const parts = Astro.props.text.split("FIRST");
---

{parts.map((part, index) => (
  <>
    {index > 0 && <FirstMark />}
    {part}
  </>
))}
