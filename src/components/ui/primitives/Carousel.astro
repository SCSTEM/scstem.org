---
import { cn } from "@/lib/cn";

import Button from "./Button.astro";
import Icon from "./Icon.astro";

/**
 * The arrows are hidden from assistive tech: the track is keyboard-scrollable and every slide is
 * reachable.
 */
interface Props {
  label: string;
  /** Slide width at `md` and up; mobile is always one full-width slide. */
  itemBasis?: string;
  arrows?: boolean;
  class?: string | undefined;
}

const { label, itemBasis = "45%", arrows = true, class: className } = Astro.props;
---

<div class={cn("relative", className)} data-carousel>
  <div
    aria-label={label}
    class={cn(
      "flex carousel-track snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth",
      "scrollbar-none [&::-webkit-scrollbar]:hidden",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
    )}
    data-carousel-track
    role="region"
    style={`--carousel-item-basis: ${itemBasis}`}
    tabindex="0"
  >
    <slot />
  </div>

  {arrows && (
    <div class="mt-4 flex justify-end gap-2">
      <Button aria-hidden="true" data-carousel-prev size="icon" tabindex={-1} variant="secondary">
        <Icon name="chevron--left" size={20} />
      </Button>
      <Button aria-hidden="true" data-carousel-next size="icon" tabindex={-1} variant="secondary">
        <Icon name="chevron--right" size={20} />
      </Button>
    </div>
  )}
</div>

<script>
  for (const carousel of document.querySelectorAll("[data-carousel]")) {
    const track = carousel.querySelector("[data-carousel-track]");
    if (!(track instanceof HTMLElement)) continue;

    // No explicit `behavior`: the track's `scroll-smooth` supplies it, so the reduced-motion
    // override can turn it off.
    const step = () => {
      const slide = track.firstElementChild?.getBoundingClientRect().width ?? track.clientWidth;
      return slide + (Number.parseFloat(getComputedStyle(track).columnGap) || 0);
    };

    carousel.querySelector("[data-carousel-prev]")?.addEventListener("click", () => {
      track.scrollBy({ left: -step() });
    });
    carousel.querySelector("[data-carousel-next]")?.addEventListener("click", () => {
      track.scrollBy({ left: step() });
    });
  }
</script>
