---
import { cn } from "@/lib/cn";

/**
 * The layout wrapper for a group of `AccordionItem`s.
 *
 * Exclusive-open comes from the native `name` attribute on `<details>`, so pass the same `name`
 * to each `AccordionItem` — Astro cannot push a prop into slotted children, and a wrapper prop
 * would have to be read back by script, which this register does without (README, rung 1).
 */
interface Props {
  /** `| undefined` because `ui/FaqList` forwards its own optional `class` straight through. */
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div class={cn("divide-y divide-border", className)}>
  <slot />
</div>
