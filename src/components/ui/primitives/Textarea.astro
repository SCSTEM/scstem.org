---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/cn";

import { fieldVariants } from "./Field.variants";

interface Props extends Omit<HTMLAttributes<"textarea">, "class"> {
  id: string;
  invalid?: boolean;
  class?: string;
}

const { id, invalid = false, rows = 5, class: className, ...rest } = Astro.props;
---

<textarea
  aria-invalid={invalid ? "true" : undefined}
  class={cn(fieldVariants({ control: "textarea", invalid }), className)}
  id={id}
  rows={rows}
  {...rest}></textarea>
