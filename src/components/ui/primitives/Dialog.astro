---
import { cn } from "@/lib/cn";

import Button from "./Button.astro";
import Icon from "./Icon.astro";

/**
 * Open from anywhere with `data-dialog-open="<id>"`; close from inside with `data-dialog-close`.
 * Without JavaScript the dialog stays closed, so it must never hold content found nowhere else.
 */
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;
---

<dialog
  aria-labelledby={`${id}-title`}
  class={cn(
    "m-auto w-[calc(100%-2rem)] max-w-lg pocket p-0 text-body",
    "backdrop:bg-black/70",
    className,
  )}
  id={id}
>
  <div class="flex items-start justify-between gap-4 p-6 pb-0">
    <h2 class="text-h3" id={`${id}-title`}>
      {title}
    </h2>
    <Button aria-label="Close dialog" data-dialog-close size="icon" variant="ghost">
      <Icon name="close" size={20} />
    </Button>
  </div>
  <div class="p-6">
    <slot />
  </div>
</dialog>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const opener = target.closest("[data-dialog-open]");
    if (opener) {
      const id = opener.getAttribute("data-dialog-open");
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    if (target.closest("[data-dialog-close]")) {
      target.closest("dialog")?.close();
      return;
    }

    // The dialog's children sit inside its padded boxes, so a click on the element itself is a
    // backdrop click.
    if (target instanceof HTMLDialogElement) target.close();
  });
</script>
