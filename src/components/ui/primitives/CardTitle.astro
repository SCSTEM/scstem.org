---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/cn";

/**
 * Inter 600, not Orbitron: card titles sit below h3 size, and Orbitron is rationed to h1–h3
 * (DESIGN.md §3). `rule` adds the machined 32px accent hairline beneath.
 */
interface Props extends Omit<HTMLAttributes<"h3">, "class"> {
  as?: "h2" | "h3" | "h4" | "p";
  rule?: boolean;
  class?: string;
}

const { as: Tag = "h3", rule = false, class: className, ...rest } = Astro.props;
---

<Tag class={cn("text-h4 font-sans font-semibold text-foreground", className)} {...rest}>
  <slot />
</Tag>
{rule && <hr class="title-rule mt-3" />}
