---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/cn";

/** Inter rather than Orbitron (reserved for h1–h3), so a FIRST® mark in a title stays italic. */
interface Props extends Omit<HTMLAttributes<"h3">, "class"> {
  as?: "h2" | "h3" | "h4" | "p";
  rule?: boolean;
  class?: string;
}

const { as: Tag = "h3", rule = false, class: className, ...rest } = Astro.props;
---

<Tag
  class={cn(
    "font-sans text-h4 font-semibold text-foreground [font-synthesis-style:auto]",
    className,
  )}
  {...rest}
>
  <slot />
</Tag>
{rule && <hr class="mt-3 title-rule" />}
