---
import { cn } from "@/lib/cn";

/**
 * A grid bubble (DESIGN.md §2.6): the column-grid marker from architectural plans, numbering a
 * top-level page section — a circled number at the start of a dash-dot center line that runs the
 * width of its container. Decorative; the heading below it carries the meaning.
 */
interface Props {
  /** The section's position on the page, from 1. */
  value: number;
  class?: string;
}

const { value, class: className } = Astro.props;
---

<div aria-hidden="true" class={cn("flex items-center select-none", className)}>
  <span class="grid size-7.5 shrink-0 place-items-center rounded-full border border-foreground/55 font-mono text-label font-semibold text-foreground">
    {String(value).padStart(2, "0")}
  </span>
  <span class="h-px flex-1 centerline"></span>
</div>
