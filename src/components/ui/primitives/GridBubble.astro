---
import { cn } from "@/lib/cn";

interface Props {
  value: number;
  class?: string;
}

const { value, class: className } = Astro.props;
---

<div aria-hidden="true" class={cn("flex items-center select-none", className)}>
  <span class="grid size-7.5 shrink-0 place-items-center rounded-full border border-foreground/55 font-mono text-label font-semibold text-foreground">
    {String(value).padStart(2, "0")}
  </span>
  <span class="h-px flex-1 centerline"></span>
</div>
