---
import { cn } from "@/lib/cn";
import { type ChalkOvalProps, handLinkShadeClass, handMarkClass, handToneClass } from "@/lib/hand";

type Props = ChalkOvalProps;

const { variant = 1, tone = "marker", around = "word", class: className } = Astro.props;

/** The inline margin matches the ring's overhang so neighbours clear it. */
const overhang = {
  word: {
    host: "mx-4",
    ring: "-inset-x-4 -inset-y-1.5 h-[calc(100%+0.75rem)] w-[calc(100%+2rem)]",
  },
  control: {
    host: "mx-6",
    ring: "-inset-x-6 -inset-y-3 h-[calc(100%+1.5rem)] w-[calc(100%+3rem)]",
  },
} as const;

/**
 * Paths must span the whole viewBox: the SVG is stretched over its content, so a partial path lands
 * beside it.
 */
const paths = {
  1: "M170 18C160 7 118 3 86 4 46 5 10 13 6 27c-3 13 26 25 80 25 48 0 86-9 89-23 1-8-8-15-27-20",
  2: "M12 16C30 6 76 3 108 5c40 3 68 11 65 25-3 14-51 23-97 21C32 49 5 41 7 28 8 20 16 14 30 10",
  3: "M176 24C172 11 128 3 92 4 48 5 8 14 5 28c-3 14 31 24 87 24 48 0 82-10 84-24 1-8-6-15-24-20",
} as const;

const rotations = { 1: "-1.2deg", 2: "0.9deg", 3: "-0.6deg" } as const;
---

<span class={cn("relative inline-block", overhang[around].host, className)}>
  <slot />
  <svg
    aria-hidden="true"
    class:list={[
      handMarkClass,
      handLinkShadeClass,
      "absolute",
      overhang[around].ring,
      handToneClass(tone),
    ]}
    preserveAspectRatio="none"
    style={`rotate: ${rotations[variant]}`}
    viewBox="0 0 180 56"
  >
    <!-- `pathLength` normalizes the dash animation so the stroke always ends fully drawn. -->
    <path d={paths[variant]} pathLength="100"></path>
  </svg>
</span>
