---
import { cn } from "@/lib/cn";
import { type ChalkOvalProps, handLinkShadeClass, handMarkClass, handToneClass } from "@/lib/hand";

type Props = ChalkOvalProps;

const { variant = 1, tone = "marker", around = "word", class: className } = Astro.props;
const maskId = `oval-${crypto.randomUUID()}`;

/** The inline margin matches the ring's overhang so neighbours clear it. */
const overhang = {
  word: {
    host: "mx-4",
    ring: "-inset-x-4 -inset-y-1.5 h-[calc(100%+0.75rem)] w-[calc(100%+2rem)]",
  },
  control: {
    host: "mx-10",
    ring: "-inset-x-10 -inset-y-5 h-[calc(100%+2.5rem)] w-[calc(100%+5rem)]",
  },
} as const;

const paths = {
  1: "M126 5C113 3 100 3 86 4 46 5 10 13 6 27c-3 13 26 25 80 25 48 0 86-9 89-23",
  2: "M54 6C72 3 92 3 108 5c40 3 68 11 65 25-3 14-51 23-97 21C32 49 5 41 7 28",
  3: "M132 6C119 3 105 3 92 4 48 5 8 14 5 28c-3 14 31 24 87 24 48 0 82-10 84-24",
} as const;

const rotations = { 1: "-1.2deg", 2: "0.9deg", 3: "-0.6deg" } as const;
---

<span class={cn("relative inline-block", overhang[around].host, className)}>
  <slot />
  <svg
    aria-hidden="true"
    class:list={[
      handMarkClass,
      handLinkShadeClass,
      "absolute",
      overhang[around].ring,
      handToneClass(tone),
    ]}
    preserveAspectRatio="none"
    style={`rotate: ${rotations[variant]}`}
    viewBox="0 0 180 56"
  >
    <defs>
      <mask
        height="72"
        id={maskId}
        mask-type="alpha"
        maskUnits="userSpaceOnUse"
        width="196"
        x="-8"
        y="-8"
      >
        <path data-oval-reveal d={paths[variant]} pathLength="100"></path>
      </mask>
    </defs>
    <path data-oval-ink d={paths[variant]} mask={`url(#${maskId})`}></path>
  </svg>
</span>

<style>
  /* A scaling mask keeps the reveal in path coordinates while the ink keeps its screen weight. */
  [data-oval-reveal] {
    stroke-linecap: butt;
    stroke-opacity: 1;
    stroke-width: 12;
    vector-effect: none;
  }

  [data-oval-ink] {
    stroke-dasharray: none;
  }
</style>
