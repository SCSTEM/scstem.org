---
import { cn } from "@/lib/cn";

/**
 * Construction lines (DESIGN.md §2.8): at each corner of **one** feature pocket per view, two
 * lines run along the pocket's edges past the corner and cross just outside it — the
 * construction lines of the lockup on the t-shirt front. Never on standard cards. Expects a
 * `relative` parent with about 20px of clear space around it, since the marks sit outside.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/**
 * One corner, mirrored into the other three. The lines cross at (16, 16) of a 44-unit box, and
 * the box is offset by 16px so that point lands on the pocket's corner: 16px of each line runs
 * past the corner and 28px along the edge.
 */
const CROSS = "M0 16H44M16 0V44";

const corners = [
  "-top-4 -left-4",
  "-top-4 -right-4 -scale-x-100",
  "-bottom-4 -left-4 -scale-y-100",
  "-right-4 -bottom-4 -scale-100",
];
---

<div aria-hidden="true" class={cn("pointer-events-none absolute inset-0", className)}>
  {corners.map((corner) => (
    <svg
      class:list={["absolute size-11 overflow-visible text-foreground/40", corner]}
      fill="none"
      viewBox="0 0 44 44"
    >
      <path d={CROSS} stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
    </svg>
  ))}
</div>
