---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "class-variance-authority";

import { cn } from "@/lib/cn";

import { badgeVariants } from "./Badge.variants";

interface Props extends Omit<HTMLAttributes<"span">, "class">, VariantProps<typeof badgeVariants> {
  class?: string;
}

const { tone, class: className, ...rest } = Astro.props;
---

<span class={cn(badgeVariants({ tone }), "spec-label", className)} {...rest}>
  <slot />
</span>
