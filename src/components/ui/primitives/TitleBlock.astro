---
import { cn } from "@/lib/cn";

interface Field {
  label: string;
  value: string;
  mono?: boolean;
  href?: string;
}

interface Props {
  fields: readonly Field[];
  orientation?: "strip" | "stack";
  class?: string;
}

const { fields, orientation = "strip", class: className } = Astro.props;
---

<dl
  class={cn(
    "grid grid-cols-1 divide-y divide-border border border-border",
    orientation === "strip" &&
      "md:auto-cols-fr md:grid-flow-col md:grid-cols-none md:divide-x md:divide-y-0",
    className,
  )}
>
  {fields.map((field) => (
    <div class="px-4 py-3">
      <dt class="spec-label text-muted">{field.label}</dt>
      <dd class:list={["mt-1 text-small text-body", field.mono === true && "font-mono"]}>
        {field.href === undefined ? field.value : <a href={field.href}>{field.value}</a>}
      </dd>
    </div>
  ))}
</dl>
