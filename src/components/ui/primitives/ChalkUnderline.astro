---
import { cn } from "@/lib/cn";
import { type HandTone, handToneClass, type HandVariant, handWipeClass } from "@/lib/hand";

interface Props {
  /** Adjacent instances must use different variants. */
  variant?: HandVariant;
  tone?: HandTone;
  class?: string;
}

const { variant = 1, tone = "marker", class: className } = Astro.props;

const paths = {
  1: "M2 6C34 2 92 1 148 4c22 1 32 2 30 3",
  2: "M4 4C40 8 96 9 150 5c18-1 26-2 26-1",
  3: "M2 5C30 3 70 2 110 3c26 1 50 3 66 5",
} as const;

const rotations = { 1: "-0.5deg", 2: "0.4deg", 3: "-0.8deg" } as const;
---

<span class={cn("relative inline-block", className)}>
  <slot />
  <svg
    aria-hidden="true"
    class:list={[handWipeClass, "absolute -bottom-1.5 left-0 h-2 w-full", handToneClass(tone)]}
    preserveAspectRatio="none"
    style={`rotate: ${rotations[variant]}`}
    viewBox="0 0 180 10"
  >
    <path d={paths[variant]} pathLength="100"></path>
  </svg>
</span>
