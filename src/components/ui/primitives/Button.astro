---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "class-variance-authority";

import { cn } from "@/lib/cn";
import { isExternal } from "@/lib/links";

import { buttonVariants } from "./Button.variants";

/**
 * The one button in the system. Renders an `<a>` when given `href` (README, "Polymorphism").
 *
 * `default` fills with the *theme's* primary pair, so identical markup is Safety Yellow on SC2
 * pages, Hazard Green on FRC, Danger Orange on FLL. One primary per view region (DESIGN.md §8).
 */
interface Props
  extends
    Omit<HTMLAttributes<"button">, "class">,
    Pick<HTMLAttributes<"a">, "download" | "hreflang" | "rel" | "target">,
    VariantProps<typeof buttonVariants> {
  /** Present ⇒ renders an anchor instead of a button. */
  href?: string | URL;
  type?: "button" | "submit" | "reset";
  class?: string;
}

/**
 * `disabled` is meaningless on an anchor — the attribute is invalid there and `:disabled` never
 * matches — so it maps to `aria-disabled`, which the variants already style, and the `href` is
 * dropped so the control is genuinely not navigable.
 */
const {
  variant,
  size,
  href,
  type = "button",
  class: className,
  disabled,
  rel,
  ...attrs
} = Astro.props;

const isLink = href !== undefined;
const Tag = isLink ? "a" : "button";

/**
 * An off-site href takes `rel="noopener"` and, unless the button is an icon, the external marker
 * (DESIGN.md §8); an icon button's glyph already names where it goes.
 */
const isExternalLink = isLink && isExternal(String(href));
---

<Tag
  aria-disabled={isLink && disabled === true ? "true" : undefined}
  class={cn(
    buttonVariants({ variant, size }),
    isExternalLink && size !== "icon" && "external-link",
    className,
  )}
  disabled={isLink ? undefined : disabled}
  href={isLink && disabled !== true ? href : undefined}
  rel={rel ?? (isExternalLink ? "noopener" : undefined)}
  type={isLink ? undefined : type}
  {...attrs}
>
  <slot />
</Tag>
