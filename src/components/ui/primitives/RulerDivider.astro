---
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const ticks = Array.from({ length: 61 }, (_, index) => index * 4);
const strip = [
  "M0 15H240",
  ...ticks.map((x) => `M${String(x)} ${String(x % 20 === 0 ? 4 : x % 8 === 0 ? 8 : 11)}V15`),
].join("");
---

<svg
  aria-hidden="true"
  class={cn("h-4 w-full text-foreground/[0.18]", className)}
  preserveAspectRatio="none"
  role="presentation"
  viewBox="0 0 240 16"
>
  <!-- `non-scaling-stroke` keeps the ticks hairlines; the stretched viewBox would widen them. -->
  <path
    d={strip}
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    vector-effect="non-scaling-stroke"
  ></path>
</svg>
