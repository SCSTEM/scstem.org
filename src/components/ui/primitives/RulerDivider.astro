---
import { cn } from "@/lib/cn";

/**
 * The strong section divider (DESIGN.md §2.7): a graduated tick strip, like the edge of a
 * steel rule. Plain 1px hairlines remain the quiet default — reach for this when a boundary
 * needs to be felt, and count it against the register budget.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/** Baseline plus 61 graduated ticks, as one path — one element instead of one per tick. */
const ticks = Array.from({ length: 61 }, (_, index) => index * 4);
const strip = [
  "M0 15H240",
  ...ticks.map((x) => `M${String(x)} ${String(x % 20 === 0 ? 4 : x % 8 === 0 ? 8 : 11)}V15`),
].join("");
---

<svg
  aria-hidden="true"
  class={cn("h-4 w-full text-foreground/[0.18]", className)}
  preserveAspectRatio="none"
  role="presentation"
  viewBox="0 0 240 16"
>
  <!-- `non-scaling-stroke`: the viewBox is stretched to the container, which would otherwise
       widen every tick by the horizontal scale factor. Ticks stay hairlines, like the rule. -->
  <path
    d={strip}
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    vector-effect="non-scaling-stroke"></path>
</svg>
