---
import type { ImageMetadata } from "astro";

import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Icon from "@/components/ui/primitives/Icon.astro";

/**
 * The poster is a real `<Image>` rather than the video's `poster` attribute, because it is the LCP
 * element and only `<Image>` gives it a responsive ladder. The video overlays it at
 * `preload="none"` and reveals itself once playing.
 */
interface Props {
  id: string;
  /** Describes the footage, since the video itself is hidden from assistive tech. */
  alt: string;
  mp4: string;
  poster: ImageMetadata;
  webm: string;
}

const { id, alt, mp4, poster, webm } = Astro.props;
---

<HeroImage alt={alt} src={poster} />

<video aria-hidden="true" data-hero-video id={id} loop muted playsinline preload="none">
  <source src={webm} type="video/webm" />
  <source src={mp4} type="video/mp4" />
</video>

<Button
  aria-controls={id}
  class="group absolute right-3 bottom-3 z-10 bg-background/55 text-foreground/80 hover:text-foreground md:right-6 md:bottom-6"
  data-video-toggle
  hidden
  size="icon"
  variant="ghost"
>
  <Icon class="group-data-[paused=true]:hidden" name="pause" size={20} />
  <Icon class="hidden group-data-[paused=true]:block" name="play--filled" size={20} />
  <span class="sr-only" data-video-label>
    Play background video
  </span>
</Button>

<style>
  video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--sc2-duration-entrance) var(--sc2-ease-entrance);
  }

  video[data-playing] {
    opacity: 1;
  }
</style>

<script>
  for (const video of document.querySelectorAll<HTMLVideoElement>("[data-hero-video]")) {
    const toggle = document.querySelector<HTMLButtonElement>(
      `[data-video-toggle][aria-controls="${video.id}"]`,
    );
    if (toggle === null) continue;
    const label = toggle.querySelector("[data-video-label]");
    if (label === null) continue;
    // `NetworkInformation` is absent from lib.dom; the `in` guard makes the read safe.
    const connection =
      "connection" in navigator ? (navigator.connection as { saveData?: boolean }) : undefined;

    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let wanted = !motion.matches && connection?.saveData !== true;
    let inView = false;

    const sync = (): void => {
      label.textContent = wanted ? "Pause background video" : "Play background video";
      toggle.dataset.paused = String(!wanted);
    };

    const playOrPause = (): void => {
      if (wanted && inView && !document.hidden) {
        void video.play().catch((error: unknown) => {
          // A pause that interrupts a pending play rejects it; only a refusal turns playback off.
          if (error instanceof DOMException && error.name === "AbortError") return;
          wanted = false;
          sync();
        });
      } else {
        video.pause();
      }
    };

    /**
     * Not before `load`: an observer armed earlier races the video's first megabyte against the LCP
     * poster.
     */
    const arm = () => {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          inView = entry.isIntersecting;
          playOrPause();
        }
      });

      // Only on `playing`: any earlier shows a blank frame over the poster. It stays revealed
      // through later pauses.
      video.addEventListener("playing", () => video.setAttribute("data-playing", ""));
      const unavailable = (): void => {
        wanted = false;
        toggle.hidden = true;
        observer.disconnect();
      };
      // A failed `<source>` reports on itself, not the video; the last one failing means none
      // loaded.
      video.addEventListener("error", unavailable);
      video.querySelector("source:last-of-type")?.addEventListener("error", unavailable);
      toggle.addEventListener("click", () => {
        wanted = !wanted;
        sync();
        playOrPause();
      });
      motion.addEventListener("change", (event) => {
        if (event.matches) {
          wanted = false;
          sync();
          playOrPause();
        }
      });
      document.addEventListener("visibilitychange", playOrPause);
      sync();
      toggle.hidden = false;
      observer.observe(video);
    };

    if (document.readyState === "complete") {
      arm();
    } else {
      window.addEventListener("load", arm, { once: true });
    }
  }
</script>
