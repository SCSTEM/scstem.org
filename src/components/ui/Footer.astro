---
import { Image } from "astro:assets";

import logoLockup from "@/assets/brand/logo-color-full.svg";
import Icon from "@/components/ui/primitives/Icon.astro";
import TitleBlock from "@/components/ui/primitives/TitleBlock.astro";
import { site } from "@/data/site";

/**
 * Site footer, styled as a recessed `card` band (DESIGN.md §2) and carrying the full-width color
 * lockup — never a grayscale logo. The title block sits at the bottom, which is where a drawing
 * sheet puts its identity strip (§2.9).
 *
 * Content inventory comes from `legacy/src/components/Footer.tsx`; the copy is verbatim.
 */
const year = new Date().getFullYear();

const sections = [
  {
    title: "Support us",
    links: [
      { label: "Donate", href: "/donate" },
      { label: "Sponsors", href: "/sponsors" },
      { label: "Wishlist", href: site.urls.wishlist },
    ],
  },
  {
    title: "Programs",
    links: [
      { label: "FIRST LEGO League", href: "/programs/fll" },
      { label: "FIRST Robotics Competition", href: "/programs/frc" },
      { label: "Calendar", href: "/calendar/sc2" },
    ],
  },
  {
    title: "Find us online",
    links: [
      { label: "Facebook", href: site.social.facebook },
      { label: "LinkedIn", href: site.social.linkedin },
      { label: "GitHub", href: site.social.github },
    ],
  },
] as const;

const socials = [
  { label: "Facebook", href: site.social.facebook, icon: "brand-facebook" },
  { label: "LinkedIn", href: site.social.linkedin, icon: "brand-linkedin" },
  { label: "GitHub", href: site.social.github, icon: "brand-github" },
] as const;
---

<footer class="bg-card mt-24">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <Image alt={site.name} class="h-auto w-full max-w-[16rem]" src={logoLockup} />
        <p class="text-small mt-4">
          {site.shortName} is 501(c)(3) non-profit focused on providing STEM opportunities for students
          in and around Franklin County PA.
        </p>
        <ul class="mt-6 flex gap-2">
          {
            socials.map((social) => (
              <li>
                <a
                  class="text-foreground hover:bg-card-hover hover:text-primary-bright grid size-11 place-items-center rounded-md no-underline"
                  href={social.href}
                  rel="noopener"
                >
                  <Icon label={social.label} name={social.icon} size={24} />
                </a>
              </li>
            ))
          }
          <li>
            <a
              class="text-foreground hover:bg-card-hover hover:text-primary-bright grid size-11 place-items-center rounded-md no-underline"
              href={`mailto:${site.email}`}
            >
              <Icon label={`Email ${site.name}`} name="mail" size={24} />
            </a>
          </li>
        </ul>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 md:grid-cols-3">
        {
          sections.map((section) => (
            <div>
              <h2 class="text-h4 text-foreground font-sans font-semibold">{section.title}</h2>
              <hr class="title-rule mt-2" />
              <ul class="mt-3 flex flex-col gap-2">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="text-small text-body hover:text-primary-bright no-underline"
                      href={link.href}
                      rel={link.href.startsWith("http") ? "noopener" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <TitleBlock
      class="mt-12"
      fields={[
        { label: "Organization", value: site.name },
        { label: "Workspace", value: site.location.workspace },
        { label: "Contact", value: site.email, href: `mailto:${site.email}`, mono: true },
        { label: "Copyright", value: `© ${String(year)}`, mono: true },
      ]}
    />
  </div>
</footer>
