---
import type { HTMLAttributes } from "astro/types";

import Button from "@/components/ui/primitives/Button.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import { site, socials } from "@/data/site";

interface Props extends Omit<HTMLAttributes<"ul">, "class"> {
  email?: boolean;
  class?: string;
}

const { email = false, class: className, ...attrs } = Astro.props;

const links = email
  ? [...socials, { label: `Email ${site.name}`, href: `mailto:${site.email}`, icon: "email" }]
  : socials;
---

<ul class:list={["flex gap-2", className]} {...attrs}>
  {links.map((link) => (
    <li>
      <Button class="hover:bg-card-hover" href={link.href} size="icon" variant="ghost">
        <Icon label={link.label} name={link.icon} size={24} />
      </Button>
    </li>
  ))}
</ul>
