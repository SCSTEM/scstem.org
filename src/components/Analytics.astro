---
import { nav, site } from "@/data/site";
import { TRACK_EVENT } from "@/lib/analytics";

/**
 * Both the `PROD` gate and the hostname gate are needed: a preview deploy is a real hostname
 * serving a production build, so the build-time gate alone would pollute the production property.
 */
const { hostname } = new URL(site.url);

/**
 * Clicks on links to these hrefs fire the named event; `data-track` covers links whose href varies
 * per entry.
 */
const destinations = {
  [nav.cta.href]: "get_involved_click",
  [nav.donate.href]: "donate_click",
  [site.urls.donate]: "donate_click",
  [site.urls.wishlist]: "wishlist_click",
  [site.urls.sponsorPacket]: "sponsor_packet_download",
};

/**
 * A string, because a script body inside an Astro expression is parsed as JSX, where every `{`
 * opens an interpolation.
 */
const snippet = `
if (location.hostname === ${JSON.stringify(hostname)}) {
  addEventListener("load", function () {
    var destinations = ${JSON.stringify(destinations)};
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }

    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "granted",
    });
    gtag("js", new Date());
    gtag("config", ${JSON.stringify(site.analytics.ga4MeasurementId)});

    var tag = document.createElement("script");
    tag.async = true;
    tag.src = "https://www.googletagmanager.com/gtag/js?id=" + ${JSON.stringify(site.analytics.ga4MeasurementId)};
    document.head.append(tag);

    const cfBeacon = ${JSON.stringify(site.analytics.cfBeacon)};
    if (cfBeacon) {
      var cf = document.createElement("script");
      cf.defer = true;
      cf.src = "https://static.cloudflareinsights.com/beacon.min.js";
      cf.dataset.cfBeacon = JSON.stringify({ token: cfBeacon });
      document.head.append(cf);
    }

    document.addEventListener("click", function (event) {
      var link = event.target instanceof Element ? event.target.closest("a[href]") : null;
      if (!link) return;
      var name = link.dataset.track || destinations[link.getAttribute("href")];
      if (name) gtag("event", name);
    });

    document.addEventListener(${JSON.stringify(TRACK_EVENT)}, function (event) {
      gtag("event", event.detail);
    });
  });
}
`;
---

{import.meta.env.PROD && <script is:inline set:html={snippet}></script>}
