---
import JsonLd from "@/components/JsonLd.astro";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { webSite } from "@/lib/jsonld";

/**
 * Placeholder until Phase 06 ports the homepage. Present so the app shell is visible on the
 * preview URL; never deployed to production.
 */
---

<BaseLayout description={site.description} title="Home">
  <JsonLd data={webSite()} slot="head" />

  <section class="section-y ambient-pool mx-auto max-w-6xl px-4 md:px-6">
    <p class="eyebrow text-primary">Rewrite in progress</p>
    <h1 class="mt-2">The app shell is in place</h1>
    <p class="measure text-body-lg mt-4">
      Header, footer, metadata, and structured data are live. The homepage itself lands in Phase 06;
      the design system and every primitive are on the{" "}
      <a href="/styleguide">styleguide</a>.
    </p>
  </section>
</BaseLayout>
