---
import getInvolved from "@/assets/sc2/get-involved.webp";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import JoiningFaq from "@/components/ui/JoiningFaq.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Section from "@/components/ui/Section.astro";
import { nav, programs, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * Native `loading="lazy"` fetches a frame well before it scrolls into view, so a script assigns
 * `src` once it does.
 */
const embedded = `${site.urls.getInvolvedForm}?embedded=true`;
const formTitle = `${nav.cta.label} with the ${site.name}`;
---

<BaseLayout
  description="Students, parents, mentors, and sponsors all start here: a short form, then a South Central STEM Collective volunteer writes back."
  title="Get involved"
  trail={[{ name: nav.cta.label, path: nav.cta.href }]}
>
  <Hero>
    <HeroImage
      alt="Students and mentors working together at a build session"
      caption="A build session"
      slot="media"
      src={getInvolved}
    />
    <Fragment slot="title">Get involved</Fragment>
    Students, parents, mentors, volunteers, and businesses all start with the same short form. A
    volunteer emails you back to learn a bit more, then invites you to a meeting or sends the
    details you asked for.
    <Button href="#form" size="lg" slot="actions">
      Fill out the form
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">Where you fit</Fragment>

    <FeatureGrid columns={2}>
      <FeatureCard cta="Compare the programs" href={programs.sc2.href} icon="education">
        <Fragment slot="title">Students and parents</Fragment>
        <FirstMark /> LEGO League is for ages {programs.fll.ages}, and {programs.frc.teamName} for
        ages {programs.frc.ages}.
      </FeatureCard>

      <FeatureCard icon="group">
        <Fragment slot="title">Mentors and volunteers</Fragment>
        Professionals who can teach a skill, and parents who can lend a hand. Every mentor and
        volunteer follows Pennsylvania and <FirstMark /> youth-protection guidelines.
      </FeatureCard>

      <FeatureCard cta="See who sponsors us" href={nav.sponsors.href} icon="enterprise">
        <Fragment slot="title">Sponsors</Fragment>
        Businesses fund our tools, workspace, and registration fees. Tell us about your company on
        the form, and we&rsquo;ll send the sponsorship details.
      </FeatureCard>

      <FeatureCard cta="Request a demonstration" href={nav.contact.href} icon="events">
        <Fragment slot="title">Schools and community groups</Fragment>
        Skip the form: send us the date and place, and we&rsquo;ll see which team can bring a robot.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <JoiningFaq />

  <Section atmosphere="pool" id="form">
    <Fragment slot="title">Tell us about you</Fragment>
    <Fragment slot="intro">
      The form takes a couple of minutes, and nothing on it is binding. Tell us who you are and what
      you&rsquo;re curious about.
    </Fragment>

    <Button href={site.urls.getInvolvedForm} variant="secondary">
      Open the form in Google Forms
    </Button>

    <!-- Google's form page is transparent around its white card. The wrapper declares light to
      match the form's `color-scheme`; a mismatch paints an opaque backdrop behind the frame and
      dark-on-white fields. -->
    <div class="mt-8 scheme-light">
      <iframe
        class="h-450 w-full border-0"
        data-form-embed
        data-src={embedded}
        hidden
        loading="lazy"
        title={formTitle}
      ></iframe>
      <noscript>
        <iframe
          class="h-450 w-full border-0"
          loading="lazy"
          src={embedded}
          title={formTitle}
        ></iframe>
      </noscript>
    </div>
  </Section>
</BaseLayout>

<script>
  for (const frame of document.querySelectorAll<HTMLIFrameElement>("[data-form-embed]")) {
    const src = frame.dataset.src;
    if (src === undefined) continue;
    frame.hidden = false;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        frame.src = src;
        observer.disconnect();
      }
    });
    observer.observe(frame);
  }
</script>
