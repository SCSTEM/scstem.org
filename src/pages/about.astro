---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import sc2Logo from "@/assets/brand/logo-color.svg";
import biohazardLogo from "@/assets/frc/biohazard-logo.svg";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import PhotoTimeline from "@/components/ui/PhotoTimeline.astro";
import Button from "@/components/ui/primitives/Button.astro";
import SketchArrow from "@/components/ui/primitives/SketchArrow.astro";
import Section from "@/components/ui/Section.astro";
import SectionAction from "@/components/ui/SectionAction.astro";
import StatBand from "@/components/ui/StatBand.astro";
import { programPhotos } from "@/data/programPhotos";
import { nav, programs, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { awardCount, championshipSeasons, getSeasons } from "@/lib/seasons";

const NEXT_GENERATION_FROM = 2023;
const SHUTDOWN_YEAR = 2020;

const teamPhotos = (
  await Promise.all([getCollection("frcTeamPhotos"), getCollection("fllTeamPhotos")])
)
  .flat()
  .toSorted((a, b) => a.data.year - b.data.year);

const origins = teamPhotos.filter((entry) => entry.data.year < NEXT_GENERATION_FROM);
const nextGeneration = teamPhotos.filter((entry) => entry.data.year >= NEXT_GENERATION_FROM);

const seasons = await getSeasons();
const [firstChampionship] = championshipSeasons(seasons);
const championshipYear = firstChampionship?.data.year;
const preShutdown = seasons.filter((season) => season.data.year < SHUTDOWN_YEAR);

const REGIONAL_WIN = /^Regional Winner, (?<event>.+)$/u;
const regionalWins = seasons.toReversed().flatMap((season) =>
  (season.data.awards ?? []).flatMap((award) => {
    const event = REGIONAL_WIN.exec(award)?.groups?.event;
    return event === undefined ? [] : [{ event, year: season.data.year }];
  }),
);
const [firstRegionalWin] = regionalWins;

const awards = {
  value: String(awardCount(seasons)),
  label: `Awards since ${String(programs.frc.since)}`,
};
const awardsStat =
  firstRegionalWin === undefined
    ? awards
    : {
        ...awards,
        description: `Including the ${String(firstRegionalWin.year)} ${firstRegionalWin.event} win.`,
      };

const teamStats = [
  {
    value: programs.frc.students,
    label: "Students",
    description: `High schoolers, ages ${programs.frc.ages}, on the team each season.`,
  },
  {
    value: "1",
    label: "Robot a season",
    description: "Designed and built by the students, from the January kickoff.",
  },
  {
    value: String(programs.frc.competitionsPerSeason),
    label: "Competitions a season",
    description: "Each one runs Thursday to Saturday, within driving range.",
  },
  awardsStat,
];

const outreach = await getCollection("outreach");
const outreachYears = [...new Set(outreach.map((entry) => entry.data.year))].toSorted(
  (a, b) => b - a,
);
const listFormat = new Intl.ListFormat("en-US", { style: "long", type: "conjunction" });
const outreachByYear = outreachYears.map((year) => ({
  year,
  appearances: listFormat.format(
    outreach
      .filter((entry) => entry.data.year === year)
      .toSorted((a, b) => a.data.month - b.data.month)
      .map(({ data }) => (data.place === undefined ? data.name : `${data.name} in ${data.place}`)),
  ),
}));
---

<BaseLayout
  description={`Meet South Central STEM Collective: a ${site.location.locality}, PA nonprofit helping students learn through robotics, mentorship, and community involvement.`}
  title="About"
  trail={[{ name: nav.about.label, path: nav.about.href }]}
>
  <Hero>
    <HeroImage
      alt={programPhotos.sc2.alt}
      caption={programPhotos.sc2.caption}
      slot="media"
      src={programPhotos.sc2.image}
    />

    <Fragment slot="title">About us</Fragment>

    <p>
      At {site.name}, students explore STEM by building robots together. Our two <FirstMark />{" "}
      programs bring students and volunteer mentors into the workshop to turn ideas into working
      machines and take them to competition.
    </p>
    <p class="mt-4">
      We meet in downtown {site.location.locality}, {site.location.region}, and welcome students
      from {site.location.county} and beyond. Families and sponsors help keep the teams running
      alongside the students and mentors.
    </p>

    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">Our beginnings</Fragment>

    <div class="prose-copy">
      <p>
        A small group of students and volunteers formed {programs.frc.teamName} in{" "}
        {programs.frc.since} as a <FirstMark /> Robotics Competition club under the local 4-H
        program office.
      </p>
      <p>
        The team won {awardCount(preShutdown)} awards in its first {preShutdown.length} seasons
        {firstRegionalWin !== undefined ? (
          <>
            , including a win at the {firstRegionalWin.event} in {firstRegionalWin.year}.
          </>
        ) : (
          <>.</>
        )}{" "}
        {championshipYear !== undefined &&
          (championshipYear === firstRegionalWin?.year ? (
            <>
              The same season, it played at the <FirstMark /> Championship.
            </>
          ) : (
            <>
              In {championshipYear} it played at the <FirstMark /> Championship.
            </>
          ))}
      </p>
    </div>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">Where Biohazard began</Fragment>
    <PhotoTimeline label="Biohazard team photos, 2013 to 2022" photos={origins} />
  </Section>

  <Section atmosphere="bubble" index={2}>
    <Fragment slot="title">Growing beyond one team</Fragment>

    <figure>
      <div class="grid items-center gap-4 md:grid-cols-[minmax(0,1fr)_2rem_minmax(0,2fr)]">
        <div class="flex items-center justify-self-center gap-4 md:flex-col md:text-center lg:flex-row lg:text-left">
          <Image alt="" class="w-24 shrink-0 lg:w-32" loading="lazy" src={biohazardLogo} />
          <div>
            <p class="text-h3 font-display font-semibold text-foreground">
              {programs.frc.teamName}
            </p>
            <p class="mt-1 text-copy">Founded in {programs.frc.since}</p>
          </div>
        </div>

        <div class="justify-self-center rotate-90 md:rotate-0">
          <SketchArrow class="size-10" direction="right" />
        </div>

        <div class="pocket p-4 sm:p-5">
          <div class="flex items-center gap-3">
            <Image alt="" class="w-12 shrink-0 md:w-14" loading="lazy" src={sc2Logo} />
            <div>
              <p class="text-h4 font-semibold text-foreground">{site.name}</p>
              <p class="mt-1 text-small">Nonprofit formed in {site.founded}</p>
            </div>
          </div>

          <ul class="mt-4 grid gap-4 border-t border-border pt-4 sm:grid-cols-2">
            <li class="flex items-start gap-3">
              <Image alt="" class="w-8 shrink-0" loading="lazy" src={biohazardLogo} />
              <div>
                <p class="font-semibold text-foreground">{programs.frc.teamName}</p>
                <p class="mt-1 text-small">High-school robotics</p>
              </div>
            </li>
            <li>
              <p class="font-semibold text-foreground">
                <FirstMark /> LEGO® League
              </p>
              <p class="mt-1 text-small">Teams for younger students</p>
            </li>
          </ul>
        </div>
      </div>
      <figcaption class="mt-4 measure">
        {programs.frc.teamName} continues as our high-school team, now alongside <FirstMark /> LEGO®
        League within the South Central STEM Collective.
      </figcaption>
    </figure>

    <div class="prose-copy mt-8">
      <p>
        When the pandemic interrupted the {SHUTDOWN_YEAR} season, parents and mentors began planning
        an independent nonprofit to support {programs.frc.teamName} and create more STEM
        opportunities. Our years with Franklin County 4-H had established a foundation of teamwork,
        service, and community involvement.
      </p>
      <p>
        In {site.founded}, the South Central STEM Collective became its own 501(c)(3), and{" "}
        {programs.frc.teamName} returned to regional competition in 2022. We also added{" "}
        <FirstMark /> LEGO® League for younger students; both programs now share our downtown{" "}
        {site.location.locality} workspace.
      </p>
      <p>
        Our mission is to make STEM opportunities accessible to students of all ages and
        backgrounds. We provide the workspace, tools, insurance, and volunteer oversight that keep
        our teams running, including youth protection and training.
      </p>
      <p>
        Each team manages its activities, fundraising, and schedule, with students, families, and
        mentors working together. Shared resources give teams space to focus on learning and
        building.
      </p>
    </div>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">The next generation</Fragment>
    <PhotoTimeline
      label="Biohazard and FIRST LEGO League team photos, 2023 onward"
      photos={nextGeneration}
    />
  </Section>

  <Section atmosphere="bubble" index={3}>
    <Fragment slot="title">Biohazard today</Fragment>

    <StatBand stats={teamStats} />

    <div class="prose-copy mt-10">
      <p>
        Of {programs.frc.teamName}&rsquo;s {programs.frc.mentors} professional mentors,{" "}
        {programs.frc.alumniMentors} are alumni who returned to help students on the team where they
        started.
      </p>
      <p>
        Every mentor and volunteer follows Pennsylvania and <FirstMark /> youth-protection
        guidelines, and we keep a two-deep policy: at least two adults are with students at all
        times.
      </p>
    </div>
  </Section>

  <Section atmosphere="bubble" index={4}>
    <Fragment slot="title">Sharing STEM across our region</Fragment>

    <div class="prose-copy">
      <p>
        Our students bring robots to school expos, sponsor events, and community festivals across
        south-central Pennsylvania. They explain how the robots work and share what they learned
        building them.
      </p>
      {outreachByYear.map(({ year, appearances }) => (
        <p>
          In {year}: {appearances}.
        </p>
      ))}
    </div>

    <SectionAction href={nav.contact.href} prompt="Want to see one up close?" slot="action">
      Request a robot demonstration
    </SectionAction>
  </Section>

  <Section atmosphere="bubble" index={5}>
    <Fragment slot="title">Where we&rsquo;re headed</Fragment>
    <Fragment slot="intro">
      With more sponsors and volunteers, we want to expand beyond robotics teams and demonstrations
      to offer workshops and a permanent makerspace.
    </Fragment>

    <div class="prose-copy">
      <ul>
        <li>
          Run hands-on STEM workshops open to any student, once we have the sponsors and volunteers
          to staff them
        </li>
        <li>Operate and maintain a makerspace</li>
        <li>Secure a permanent location for our workspace, classrooms, and office space</li>
        <li>Reach more students through community events and partnerships</li>
      </ul>
    </div>
  </Section>

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">Be part of what comes next</Fragment>
      Help shape our next season as a student, volunteer, or supporter. Tell us how you&rsquo;d like
      to take part, and we&rsquo;ll put you in touch with a volunteer.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={nav.contact.href} size="lg" slot="actions" variant="secondary">
        Contact us
      </Button>
    </CtaBanner>
  </Section>
</BaseLayout>
