---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import sc2Logo from "@/assets/brand/logo-color.svg";
import biohazardLogo from "@/assets/frc/biohazard-logo.svg";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import PhotoTimeline from "@/components/ui/PhotoTimeline.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Section from "@/components/ui/Section.astro";
import SectionAction from "@/components/ui/SectionAction.astro";
import StatBand from "@/components/ui/StatBand.astro";
import { programPhotos } from "@/data/programPhotos";
import { nav, programs, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { awardCount, championshipSeasons, getSeasons } from "@/lib/seasons";

const NEXT_GENERATION_FROM = 2023;
const SHUTDOWN_YEAR = 2020;

const teamPhotos = (
  await Promise.all([getCollection("frcTeamPhotos"), getCollection("fllTeamPhotos")])
)
  .flat()
  .toSorted((a, b) => a.data.year - b.data.year);

const origins = teamPhotos.filter((entry) => entry.data.year < NEXT_GENERATION_FROM);
const nextGeneration = teamPhotos.filter((entry) => entry.data.year >= NEXT_GENERATION_FROM);

const seasons = await getSeasons();
const [firstChampionship] = championshipSeasons(seasons);
const championshipYear = firstChampionship?.data.year;
const preShutdown = seasons.filter((season) => season.data.year < SHUTDOWN_YEAR);

const REGIONAL_WIN = /^Regional Winner, (?<event>.+)$/u;
const regionalWins = seasons.toReversed().flatMap((season) =>
  (season.data.awards ?? []).flatMap((award) => {
    const event = REGIONAL_WIN.exec(award)?.groups?.event;
    return event === undefined ? [] : [{ event, year: season.data.year }];
  }),
);
const [firstRegionalWin] = regionalWins;

const awards = {
  value: String(awardCount(seasons)),
  label: `Awards since ${String(programs.frc.since)}`,
};
const awardsStat =
  firstRegionalWin === undefined
    ? awards
    : {
        ...awards,
        description: `Including the ${String(firstRegionalWin.year)} ${firstRegionalWin.event} win.`,
      };

const teamStats = [
  {
    value: programs.frc.students,
    label: "Students",
    description: `High schoolers, ages ${programs.frc.ages}, on the team each season.`,
  },
  {
    value: "1",
    label: "Robot a season",
    description: "Designed and built by the students, from the January kickoff.",
  },
  {
    value: String(programs.frc.competitionsPerSeason),
    label: "Competitions a season",
    description: "Each one runs Thursday to Saturday, within driving range.",
  },
  awardsStat,
];

const outreach = await getCollection("outreach");
const outreachYears = [...new Set(outreach.map((entry) => entry.data.year))].toSorted(
  (a, b) => b - a,
);
const listFormat = new Intl.ListFormat("en-US", { style: "long", type: "conjunction" });
const outreachByYear = outreachYears.map((year) => ({
  year,
  appearances: listFormat.format(
    outreach
      .filter((entry) => entry.data.year === year)
      .toSorted((a, b) => a.data.month - b.data.month)
      .map(({ data }) => (data.place === undefined ? data.name : `${data.name} in ${data.place}`)),
  ),
}));
---

<BaseLayout
  description={`How a 4-H robotics club founded in ${String(programs.frc.since)} became, in ${String(site.founded)}, a 501(c)(3) making STEM accessible across Franklin County, PA.`}
  title="About"
  trail={[{ name: nav.about.label, path: nav.about.href }]}
>
  <Hero>
    <HeroImage
      alt={programPhotos.sc2.alt}
      caption={programPhotos.sc2.caption}
      slot="media"
      src={programPhotos.sc2.image}
    />

    <Fragment slot="title">About us</Fragment>

    <p>
      The South Central STEM Collective (SC2) started with one high-school robotics team,{" "}
      {programs.frc.teamName}, in {programs.frc.since}. Since becoming its own nonprofit in{" "}
      {site.founded}, it has added <FirstMark /> LEGO League for younger students, and today it runs
      both for ages 9–18 out of a workspace in downtown Chambersburg.
    </p>

    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">History</Fragment>

    <div class="flex flex-col-reverse items-start gap-8 md:flex-row md:gap-12">
      <div class="prose-copy">
        <h3>{programs.frc.teamName}</h3>
        <p>
          {programs.frc.teamName} is a <FirstMark /> Robotics Competition team, formed in{" "}
          {programs.frc.since} by a small group of students and volunteers as a club under the local
          4-H program office.
        </p>
        <p>
          In its first {preShutdown.length} seasons, the team won {awardCount(preShutdown)} awards.{" "}
          {firstRegionalWin !== undefined && (
            <>
              In {firstRegionalWin.year} it won the {firstRegionalWin.event}.{" "}
            </>
          )}
          {championshipYear !== undefined &&
            (championshipYear === firstRegionalWin?.year ? (
              <>
                The same season, it played at the <FirstMark /> Championship.
              </>
            ) : (
              <>
                In {championshipYear} it played at the <FirstMark /> Championship.
              </>
            ))}
        </p>
      </div>

      <Image
        alt={`${programs.frc.teamName} robotics team logo`}
        class="w-32 shrink-0 md:w-48"
        loading="lazy"
        src={biohazardLogo}
      />
    </div>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">Where Biohazard began</Fragment>
    <PhotoTimeline label="Biohazard team photos, 2013 to 2022" photos={origins} />
  </Section>

  <Section atmosphere="bubble" index={2}>
    <Fragment slot="title">{SHUTDOWN_YEAR} and beyond</Fragment>

    <div class="prose-copy">
      <p>
        For {programs.frc.teamName}, {SHUTDOWN_YEAR} started like any season: kickoff in early
        January, weeks of building, and a first competition in Myrtle Beach, SC, at the end of
        February. The robot needed work before Pittsburgh, and in the weeks between, the world shut
        down. The team didn&rsquo;t return to a regional event until 2022.
      </p>
      <p>
        Stuck at home, still itching to compete, and seeing how much the students cared, we started
        asking: &ldquo;Why couldn&rsquo;t we break away from 4-H and start our own program?&rdquo;
        We were proud of our 4-H partnership, as our original website said:
      </p>
      <blockquote>
        The students of Biohazard 4050 are not only members of <FirstMark />, but are also members
        of the Franklin County (PA) 4-H Program. Their dual membership gives them a unique
        perspective and opportunities for local service and outreach within their community. The
        students&rsquo; dedication to each other and their commitment to their community is a
        testimony to their character, service, and leadership skills. The volunteers and mentors of
        Biohazard 4050 are very proud of the students, and honored to be a part of their
        experiences!
        <cite>Biohazard, 2015</cite>
      </blockquote>
      <p>
        But the partnership was holding back growth: complicated finances, fundraising limits,
        membership rules, and a structure that couldn&rsquo;t keep pace with STEM. After months of
        planning, with support from {programs.frc.teamName}&rsquo;s parents and mentors, the South
        Central STEM Collective became its own 501(c)(3) in {site.founded}.
      </p>
    </div>

    <div class="mt-10 flex flex-col-reverse items-start gap-8 md:flex-row md:gap-12">
      <div class="prose-copy">
        <h3>South Central STEM Collective</h3>
        <p>
          Our mission: make STEM opportunities accessible to students of all ages and backgrounds.
        </p>
        <p>
          That can take many forms, but the focus is always the students. So we set up a simple
          three-tier structure:
        </p>
      </div>

      <Image
        alt="South Central STEM Collective logo: a light bulb surrounded by a gear."
        class="w-32 shrink-0 md:w-48"
        loading="lazy"
        src={sc2Logo}
      />
    </div>

    <div class="prose-copy mt-6">
      <ol>
        <li>
          SC2 is the umbrella
          <ul>
            <li>The 501(c)(3) nonprofit</li>
            <li>Insurance, the workspace, and the books</li>
            <li>Youth protection and volunteer oversight</li>
            <li>Tools, and training on them</li>
            <li>Our presence in the community</li>
          </ul>
        </li>
        <li>
          Clubs run under SC2
          <ul>
            <li>Each club manages itself</li>
            <li>Its own leaders, goals, bank account, and schedule</li>
            <li>Use of SC2&rsquo;s workspace, tools, internet, and industry experts</li>
          </ul>
        </li>
        <li>
          Students, parents, volunteers, and mentors work with their club
          <ul>
            <li>
              Activities, competitions, and outside programs like <FirstMark />
            </li>
            <li>Fundraising for the club</li>
          </ul>
        </li>
      </ol>
      <p>
        This lets member clubs run independently while drawing on SC2&rsquo;s resources. The
        structure may change, but we believe it can have real impact, free of another parent
        organization&rsquo;s priorities.
      </p>
    </div>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">The next generation</Fragment>
    <PhotoTimeline
      label="Biohazard and FIRST LEGO League team photos, 2023 onward"
      photos={nextGeneration}
    />
  </Section>

  <Section atmosphere="bubble" index={3}>
    <Fragment slot="title">The team today</Fragment>

    <StatBand stats={teamStats} />

    <div class="prose-copy mt-10">
      <p>
        {programs.frc.teamName} works with {programs.frc.mentors} professional mentors.{" "}
        {programs.frc.alumniMentors} of them are alumni who came back to mentor the team that taught
        them.
      </p>
      <p>
        Every mentor and volunteer follows Pennsylvania and <FirstMark /> youth-protection
        guidelines, and we keep a two-deep policy: at least two adults are with students at all
        times.
      </p>
    </div>
  </Section>

  <Section atmosphere="bubble" index={4}>
    <Fragment slot="title">Out in the community</Fragment>

    <div class="prose-copy">
      <p>
        The robots don&rsquo;t stay in the workspace. Our students bring them to school expos,
        sponsor events, and street festivals across the region, and show anyone who stops how they
        work.
      </p>
      {outreachByYear.map(({ year, appearances }) => (
        <p>
          In {year}: {appearances}.
        </p>
      ))}
    </div>

    <SectionAction href={nav.contact.href} prompt="Want to see one up close?" slot="action">
      Request a demonstration
    </SectionAction>
  </Section>

  <Section atmosphere="bubble" index={5}>
    <Fragment slot="title">Where we&rsquo;re headed</Fragment>
    <Fragment slot="intro">
      Our member clubs set their own course, but the mission stays the same: be south-central
      Pennsylvania&rsquo;s &ldquo;STEM Central.&rdquo;
    </Fragment>

    <div class="prose-copy">
      <p>Goals on the horizon:</p>
      <ul>
        <li>
          Run hands-on STEM workshops open to any student, once we have the sponsors and volunteers
          to staff them
        </li>
        <li>Operate and maintain a makerspace</li>
        <li>Secure a permanent location for our workspace, classrooms, and office space</li>
        <li>
          Become a staple in our community, bringing STEM education where it hasn&rsquo;t reached
          yet
        </li>
      </ul>
    </div>
  </Section>

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">What&rsquo;s your story?</Fragment>
      We started as a handful of students and volunteers. The next chapter needs a few more of both.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={nav.contact.href} size="lg" slot="actions" variant="secondary">
        Contact us
      </Button>
    </CtaBanner>
  </Section>
</BaseLayout>
