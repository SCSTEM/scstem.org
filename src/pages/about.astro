---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";

import workshop from "@/assets/sc2/hands-on-2.webp";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Callout from "@/components/ui/primitives/Callout.astro";
import Section from "@/components/ui/Section.astro";
import SectionAction from "@/components/ui/SectionAction.astro";
import { programPhotos } from "@/data/programPhotos";
import { nav, programs, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PHOTO_QUALITY } from "@/lib/images";

const [origin, youngerTeam, outreach] = await Promise.all([
  getEntry("frcTeamPhotos", "2013"),
  getEntry("fllTeamPhotos", "2024"),
  getCollection("outreach"),
]);

if (origin === undefined || youngerTeam === undefined) {
  throw new Error("The About page needs its selected Biohazard and FIRST LEGO League photos.");
}

const recentOutreach = outreach
  .toSorted((a, b) => b.data.year - a.data.year || b.data.month - a.data.month)
  .slice(0, 2);
---

<BaseLayout
  description={`Meet South Central STEM Collective, the ${site.location.locality}, PA nonprofit behind Biohazard and FIRST LEGO League. Get to know our students, mentors, and story.`}
  title="About"
  trail={[{ name: nav.about.label, path: nav.about.href }]}
>
  <Hero>
    <HeroImage
      alt={programPhotos.sc2.alt}
      caption={programPhotos.sc2.caption}
      slot="media"
      src={programPhotos.sc2.image}
    />
    <Fragment slot="title">About us</Fragment>
    <p>
      {site.name} is the {site.location.locality} nonprofit behind {programs.frc.teamName} and our{" "}
      <FirstMark /> LEGO® League teams. We bring students and volunteer mentors together to build
      robots, solve problems, and learn from each other.
    </p>
    <p class="mt-4">
      We welcome students from {site.location.county} and beyond, with or without robotics
      experience. Both programs meet in our downtown workspace.
    </p>
    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">A place to build and learn</Fragment>
    <Fragment slot="intro">
      Our teams take part in <FirstMark />, a worldwide youth robotics community where students
      design, build, and compete together.
    </Fragment>

    <div class="grid gap-10 md:grid-cols-2 md:gap-y-0">
      <div data-about-program>
        <figure>
          <div class="media-frame">
            <Image
              alt={youngerTeam.data.alt}
              class="w-full"
              loading="lazy"
              quality={PHOTO_QUALITY}
              sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, 92vw"
              src={youngerTeam.data.photo}
              width={960}
              widths={[480, 672, 960]}
            />
          </div>
          <Callout as="figcaption" class="mt-3" figure>
            Celebrating together, {youngerTeam.data.year}
          </Callout>
        </figure>
        <p class="mt-6 spec-label text-primary-bright">Ages {programs.fll.ages}</p>
        <h3 class="mt-2">
          <FirstMark /> LEGO® League
        </h3>
        <p class="mt-3">
          Younger students build and program LEGO® robots, investigate a real-world problem, and
          share their ideas with judges.
        </p>
        <p class="mt-4">
          <a href={programs.fll.href}>Explore LEGO® League</a>
        </p>
      </div>

      <div data-about-program>
        <figure>
          <div class="media-frame">
            <Image
              alt="Biohazard students discussing a robot mechanism in the workshop"
              class="w-full"
              loading="lazy"
              quality={PHOTO_QUALITY}
              sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, 92vw"
              src={workshop}
              width={960}
              widths={[480, 672, 960]}
            />
          </div>
          <Callout as="figcaption" class="mt-3" figure>
            Working through a design together
          </Callout>
        </figure>
        <p class="mt-6 spec-label text-primary-bright">Ages {programs.frc.ages}</p>
        <h3 class="mt-2">{programs.frc.teamName}</h3>
        <p class="mt-3">
          Our high-school <FirstMark /> Robotics Competition team builds a full-size robot each
          season. Students contribute through engineering, programming, design, and fundraising.
        </p>
        <p class="mt-4">
          <a href={programs.frc.href}>Explore Biohazard</a>
        </p>
      </div>
    </div>

    <div class="prose-copy mt-10">
      <p>
        Families, sponsors, and volunteers keep our shared workspace and teams running. Of{" "}
        {programs.frc.teamName}&rsquo;s {programs.frc.mentors} professional mentors,{" "}
        {programs.frc.alumniMentors} are alumni who returned to mentor the team. At least two adults
        are with students at every meeting and event, and our volunteers follow Pennsylvania and{" "}
        <FirstMark /> youth-protection guidelines.
      </p>
    </div>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">How Biohazard became a bigger idea</Fragment>

    <div class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <figure>
        <Image
          alt={origin.data.alt}
          class="w-full rounded-lg"
          loading="lazy"
          quality={PHOTO_QUALITY}
          src={origin.data.photo}
        />
        <Callout as="figcaption" class="mt-3" figure>
          Biohazard&rsquo;s early years, {origin.data.year}
        </Callout>
      </figure>
      <div class="prose-copy">
        <p>
          Our story began in {programs.frc.since} with {programs.frc.teamName}, a high-school
          robotics team formed through Franklin County 4-H. Students and volunteers built a
          community around learning, teamwork, and competition.
        </p>
        <p>
          In {site.founded}, parents and mentors established {site.name} as an independent 501(c)(3)
          to support the team and create more STEM opportunities. {programs.frc.teamName} continues
          today alongside our <FirstMark /> LEGO® League teams for younger students. Sharing a
          workspace, tools, and volunteer support lets us bring those opportunities to more
          families.
        </p>
      </div>
    </div>
    <SectionAction href={nav.history.href} slot="action">
      Explore our history and team photos
    </SectionAction>
  </Section>

  <Section atmosphere="bubble" index={2}>
    <Fragment slot="title">Sharing STEM in our community</Fragment>
    <Fragment slot="intro">
      Students bring robots to school expos, sponsor events, and local festivals, explaining how
      they work and what it took to build them.
    </Fragment>

    <ul class="grid gap-8 md:grid-cols-2">
      {recentOutreach.map(({ data }) => (
        <li class="border-t border-border pt-4">
          <p class="spec-label text-primary-bright">{data.year}</p>
          <h3 class="mt-2">{data.name}</h3>
          <p class="mt-3">{data.description}</p>
        </li>
      ))}
    </ul>
    <SectionAction href={nav.contact.href} slot="action" variant={2}>
      Request a robot demonstration
    </SectionAction>
  </Section>

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">Be part of what comes next</Fragment>
      Join a team, share your skills, or help fund our next season. With more volunteers and
      sponsors, we hope to add hands-on workshops and a permanent makerspace.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={nav.donate.href} size="lg" slot="actions" variant="secondary">
        Support our teams
      </Button>
    </CtaBanner>
  </Section>
</BaseLayout>

<style>
  @reference "../styles/global.css";

  @media (width >= theme(--breakpoint-md)) {
    [data-about-program] {
      display: grid;
      grid-row: span 5;
      grid-template-rows: repeat(5, auto);
      grid-template-rows: subgrid;
    }
  }
</style>
