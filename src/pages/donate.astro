---
import drillBits from "@/assets/sc2/drill-bits.webp";
import ContactForm from "@/components/ui/ContactForm.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Section from "@/components/ui/Section.astro";
import { SPONSOR_LEVELS } from "@/content.config";
import { ogCards } from "@/data/ogCards";
import { nav, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * One action accent per view, so every card is `primary`; ranking is carried by order and content.
 */
const mailingAddress = [
  site.name,
  site.location.street,
  `${site.location.locality}, ${site.location.region} ${site.location.postalCode}`,
];
---

<BaseLayout
  description="Give by mail, online through PayPal Giving Fund, in kind, or as a corporate sponsor. Every route supports STEM programs in Franklin County."
  og={ogCards.donate}
  title="Donate"
  trail={[{ name: nav.donate.label, path: nav.donate.href }]}
>
  <Hero>
    <HeroImage
      alt="A rack of drill bits on the workshop wall"
      caption="Drill bits on the shop wall"
      slot="media"
      src={drillBits}
    />
    <Fragment slot="title">
      <span class="highlight-swipe">Support</span>
      <span class="block">local STEM</span>
    </Fragment>
    Your gift buys tools and materials, keeps the workspace open, and pays competition registration
    fees, so families pay little or nothing. Here&rsquo;s every way to give.
    <Button href={site.urls.donate} size="lg" slot="actions">
      Donate through PayPal
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">Ways to give</Fragment>

    <FeatureGrid columns="2+3">
      <FeatureCard icon="email">
        <Fragment slot="title">By mail</Fragment>
        <p>Mail a check to the workspace, or hand it to us at any community event.</p>
        <p class="mt-4 font-semibold text-foreground">Make checks payable to:</p>
        <p class="font-mono text-body">{site.name}</p>
        <p class="mt-4 font-semibold text-foreground">Mailing address:</p>
        <address class="font-mono text-body not-italic">
          {mailingAddress.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
      </FeatureCard>

      <FeatureCard icon="partnership">
        <Fragment slot="title">Charitable giving fund</Fragment>
        <p>Your giving fund may already list us. Search by name or EIN.</p>
        <dl class="mt-4">
          <dt class="spec-label text-muted">Name</dt>
          <dd class="text-body">{site.name}</dd>
          <dt class="mt-3 spec-label text-muted">EIN</dt>
          <dd class="font-mono text-body">{site.ein}</dd>
        </dl>
        <p class="mt-4">
          Not listed? <a href="#questions">Let us know</a>.
        </p>
      </FeatureCard>

      <FeatureCard
        badge="via PayPal"
        cta="Open PayPal Giving Fund"
        href={site.urls.donate}
        icon="wallet"
      >
        <Fragment slot="title">Online</Fragment>
        Give securely through PayPal Giving Fund.
      </FeatureCard>

      <FeatureCard cta="See our wishlist" href={site.urls.wishlist} icon="tools">
        <Fragment slot="title">In kind</Fragment>
        <p>
          Tools, materials, and equipment keep the workspace stocked. Check the wishlist for current
          needs, then contact us to arrange a drop-off.
        </p>
      </FeatureCard>

      <FeatureCard cta="See sponsorship levels" href={nav.sponsors.href} icon="document">
        <Fragment slot="title">Corporate sponsorship</Fragment>
        Businesses sponsor a season at one of {SPONSOR_LEVELS.length} levels, each recognized on our
        sponsors page.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <Section align="center" atmosphere="pool-neutral" id="questions">
    <Fragment slot="title">Questions about giving</Fragment>
    <Fragment slot="intro">
      Sponsorships, in-kind gifts, giving funds, or anything else: ask here and a volunteer will
      answer.
    </Fragment>

    <ContactForm class="mx-auto max-w-3xl" name="Sponsor Question" />
  </Section>
</BaseLayout>
