---
import drillBits from "@/assets/sc2/drill-bits.webp";
import ContactForm from "@/components/ui/ContactForm.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Link from "@/components/ui/primitives/Link.astro";
import Section from "@/components/ui/Section.astro";
import { SPONSOR_LEVELS } from "@/content.config";
import { ogCards } from "@/data/ogCards";
import { nav, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * One action accent per view, so every card is `primary`; ranking is carried by order and content.
 */
const mailingAddress = [
  site.name,
  site.location.street,
  `${site.location.locality}, ${site.location.region} ${site.location.postalCode}`,
];
---

<BaseLayout
  description="Give students tools, a place to build, and opportunities to compete. Support South Central STEM Collective online, by mail, with equipment, or as a sponsor."
  og={ogCards.donate}
  title="Donate"
  trail={[{ name: nav.donate.label, path: nav.donate.href }]}
>
  <Hero>
    <HeroImage
      alt="Drill bits arranged in a holder beside an open tool case"
      caption="Drill bits in the workshop"
      slot="media"
      src={drillBits}
    />
    <Fragment slot="title">
      Help students <span class="highlight-swipe">learn by doing</span>
    </Fragment>
    Your gift puts tools and materials in students&rsquo; hands, keeps our
    {site.location.locality} workspace open, and helps cover registration fees so our teams can take
    their robots to competition.
    <Button href={site.urls.donate} size="lg" slot="actions">
      Donate through PayPal
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">Ways to give</Fragment>

    <FeatureGrid columns="2+3">
      <FeatureCard icon="email">
        <Fragment slot="title">By mail</Fragment>
        <p>Mail a check to our workspace, or give it to us at a community event.</p>
        <p class="mt-4 font-semibold text-foreground">Make checks payable to:</p>
        <p class="font-mono text-body">{site.name}</p>
        <p class="mt-4 font-semibold text-foreground">Mailing address:</p>
        <address class="font-mono text-body not-italic">
          {mailingAddress.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
      </FeatureCard>

      <FeatureCard icon="partnership">
        <Fragment slot="title">Charitable giving fund</Fragment>
        <p>
          Search for us in your giving fund by organization name or employer identification number
          (EIN).
        </p>
        <dl class="mt-4">
          <dt class="spec-label text-muted">Name</dt>
          <dd class="text-body">{site.name}</dd>
          <dt class="mt-3 spec-label text-muted">EIN</dt>
          <dd class="font-mono text-body">{site.ein}</dd>
        </dl>
        <p class="mt-4">
          Not listed? <Link href="#questions">Let us know</Link>.
        </p>
      </FeatureCard>

      <FeatureCard
        badge="via PayPal"
        cta="Open PayPal Giving Fund"
        href={site.urls.donate}
        icon="wallet"
      >
        <Fragment slot="title">Online</Fragment>
        Give through PayPal Giving Fund.
      </FeatureCard>

      <FeatureCard cta="See our wishlist" href={site.urls.wishlist} icon="tools">
        <Fragment slot="title">Tools and materials</Fragment>
        <p>
          Check our wishlist for the equipment and materials students need in the workshop, then
          contact us to arrange a drop-off.
        </p>
      </FeatureCard>

      <FeatureCard cta="Explore sponsorship" href={nav.sponsors.href} icon="document">
        <Fragment slot="title">Corporate sponsorship</Fragment>
        Choose from {SPONSOR_LEVELS.length} sponsorship levels to help support a season. Our
        sponsors page introduces our partners and links to the packet with recognition details.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <Section align="center" atmosphere="pool-neutral" id="questions">
    <Fragment slot="title">Questions about giving</Fragment>
    <Fragment slot="intro">
      If you have questions about sponsorship, equipment donations, or giving funds, send us a
      message and a volunteer will reply by email.
    </Fragment>

    <ContactForm class="mx-auto max-w-3xl" name="Sponsor Question" />
  </Section>
</BaseLayout>
