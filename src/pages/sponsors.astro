---
import { getCollection } from "astro:content";

import partsNotes from "@/assets/sc2/parts-notes.webp";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Section from "@/components/ui/Section.astro";
import SponsorTier from "@/components/ui/SponsorTier.astro";
import { ALUMNI_FIELDS, SPONSOR_LEVELS } from "@/content.config";
import { ogCards } from "@/data/ogCards";
import { nav, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const sponsors = await getCollection("sponsors");

const groups = SPONSOR_LEVELS.map((level) => ({
  level,
  members: sponsors.filter((entry) => entry.data.active && entry.data.level === level),
})).filter((group) => group.members.length > 0);

const past = sponsors
  .filter((entry) => !entry.data.active)
  .toSorted((a, b) => a.data.name.localeCompare(b.data.name));

const alumni = await getCollection("alumni");
const listFormat = new Intl.ListFormat("en-US", { style: "long", type: "conjunction" });
const alumniFields = listFormat.format(
  ALUMNI_FIELDS.map((field) => ({
    field,
    count: alumni.filter((entry) => entry.data.field === field).length,
  }))
    .filter((entry) => entry.count > 0)
    .toSorted((a, b) => b.count - a.count)
    .map((entry) => entry.field.toLowerCase().replace(/\bit\b/u, "IT")),
);
---

<BaseLayout
  description="The businesses and individuals backing the South Central STEM Collective's robotics and STEM programs, by level, and how your company can join them."
  og={ogCards.sponsors}
  title="Sponsors"
  trail={[{ name: nav.sponsors.label, path: nav.sponsors.href }]}
>
  <Hero>
    <HeroImage
      alt="Machined parts and hand-written build notes on the workshop bench"
      caption="Parts and build notes"
      slot="media"
      src={partsNotes}
    />
    <Fragment slot="title">
      <span class="highlight-swipe">Sponsors</span> help us build
    </Fragment>
    Local businesses fund our teams. Here&rsquo;s who backs this work, and how to join them.
    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">A local investment</Fragment>
    <Fragment slot="intro">
      The students you back go on to careers. The {alumni.length} alumni we keep up with work in{" "}
      {alumniFields}.
    </Fragment>

    <h3>Where the money goes</h3>
    <p class="mt-4 measure">
      Sponsor money goes to three places, so families pay little or nothing to take part.
    </p>

    <FeatureGrid class="mt-8" columns={3}>
      <FeatureCard icon="tools">
        <Fragment slot="title">Tools</Fragment>
        The machines and hand tools students learn on, and the materials they build with.
      </FeatureCard>
      <FeatureCard icon="building">
        <Fragment slot="title">Workspace</Fragment>
        Our workspace in downtown Chambersburg, where every team meets and builds.
      </FeatureCard>
      <FeatureCard icon="ticket">
        <Fragment slot="title">Registration</Fragment>
        <FirstMark /> registration fees for every team, every season.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <Section atmosphere="bubble" index={2}>
    <Fragment slot="title">Who backs this work</Fragment>

    <div class="flex flex-col gap-14">
      {groups.map((group) => (
        <SponsorTier level={group.level} sponsors={group.members} />
      ))}
    </div>
  </Section>

  {past.length > 0 && (
    <Section atmosphere="ruler">
      <Fragment slot="title">With thanks to</Fragment>
      <Fragment slot="intro">
        Organizations whose support carried us through earlier seasons.
      </Fragment>
      <ul class="flex flex-wrap gap-x-10 gap-y-3 text-lead text-foreground">
        {past.map((sponsor) => (
          <li>{sponsor.data.name}</li>
        ))}
      </ul>
    </Section>
  )}

  <Section>
    <CtaBanner>
      <Fragment slot="title">Build the next season with us</Fragment>
      Our packet shows what each level funds and how your company is recognized.
      <Button href={site.urls.sponsorPacket} size="lg" slot="actions">
        Sponsorship packet
      </Button>
      <Button href={nav.contact.href} size="lg" slot="actions" variant="secondary">
        Talk it through with us
      </Button>
    </CtaBanner>
  </Section>
</BaseLayout>
