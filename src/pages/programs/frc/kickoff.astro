---
import { programs } from "@/data/site";
import EventLayout from "@/layouts/EventLayout.astro";
import { getVisibleEvent } from "@/lib/events";

/**
 * `/programs/frc/kickoff` is `src/content/events/frc-kickoff.md`; `hidden: true` there
 * retires it to the FRC page. See `src/pages/openhouse.astro` for why the redirect lives here.
 */
const event = await getVisibleEvent("frc-kickoff");
if (event === undefined) {
  return Astro.redirect(programs.frc.href);
}
---

<EventLayout
  {event}
  trail={[
    { name: "Programs", path: "/programs" },
    { name: programs.frc.name, path: programs.frc.href },
  ]}
/>
