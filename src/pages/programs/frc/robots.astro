---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import pits from "@/assets/frc/robots/2021-robot-pits.webp";
import ogFrc from "@/assets/og/frc.jpg";
import JsonLd from "@/components/JsonLd.astro";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import Section from "@/components/ui/Section.astro";
import { nav, programs } from "@/data/site";
import ProgramLayout from "@/layouts/ProgramLayout.astro";
import { PHOTO_QUALITY } from "@/lib/images";
import { breadcrumbs } from "@/lib/jsonld";

/**
 * The `frcRobots` collection, newest first, as a list rather than a carousel: one that hides five
 * of six entries behind arrows is worse for readers and for search.
 */
const robots = await Promise.all(
  (await getCollection("frcRobots"))
    .toSorted((a, b) => b.data.year - a.data.year)
    .map(async (entry) => ({ ...(await render(entry)), data: entry.data })),
);
---

<ProgramLayout
  description="Every Biohazard competition robot since 2019 — Toxic Silver, Robo Fett, O'Mega, Viper, and Troubleclef — with the games they played and the awards they won."
  ogImage={ogFrc}
  ogImageAlt="The South Central STEM Collective logo over the Biohazard drive team at competition, captioned “FIRST Robotics Competition”"
  program="frc"
  title="Our robots"
>
  <JsonLd
    data={breadcrumbs([
      { name: "Programs", path: "/programs" },
      { name: programs.frc.name, path: programs.frc.href },
      { name: "Robots", path: "/programs/frc/robots" },
    ])}
    slot="head"
  />

  <Hero>
    <HeroImage
      alt="Biohazard's pit crew working on the robot between matches"
      slot="media"
      src={pits}
    />

    <Fragment slot="eyebrow">2019 &ndash; present</Fragment>
    <Fragment slot="title">Our robots</Fragment>

    Six weeks of build season, one robot, and whatever we learned the year before. Here is every
    machine Biohazard has taken to competition since 2019.
  </Hero>

  <Section atmosphere="pool">
    <h2 class="sr-only">Competition robots, newest first</h2>

    <div class="flex flex-col gap-20 md:gap-28">
      {
        robots.map(({ Content, data }, index) => (
          <article
            class:list={[
              "grid items-center gap-8 lg:gap-14",
              /* A season whose robot has no photo yet is a placeholder, not a feature: it stays
                 one narrow column rather than pairing a heading with an empty half-page frame. */
              data.image === undefined ? "max-w-xl" : "lg:grid-cols-2",
            ]}
          >
            <div class:list={[index % 2 === 1 && "lg:order-last"]}>
              {data.image === undefined ? (
                <p class="pocket px-5 py-4 spec-label text-muted">{data.imageAlt}</p>
              ) : (
                <div class="relative media-frame">
                  <Image
                    alt={data.imageAlt}
                    class="w-full"
                    loading={index === 0 ? "eager" : "lazy"}
                    quality={PHOTO_QUALITY}
                    sizes="(min-width: 64rem) 34rem, 92vw"
                    src={data.image}
                    width={1120}
                    widths={[560, 672, 840, 1120]}
                  />
                  {data.logo !== undefined && (
                    <Image
                      alt=""
                      class="absolute right-4 bottom-4 w-1/4"
                      loading="lazy"
                      src={data.logo}
                      width={280}
                      widths={[140, 280]}
                    />
                  )}
                </div>
              )}
            </div>

            <div>
              <p class="spec-label text-primary-bright">{data.yearLabel ?? data.year}</p>
              <h3 class="mt-2 text-h2">{data.name}</h3>
              {data.game !== undefined && <p class="mt-2 text-muted">{data.game}</p>}

              <div class="prose-copy mt-5">
                <Content />
              </div>

              {data.achievements !== undefined && (
                <ul class="mt-6 flex flex-col gap-2">
                  {data.achievements.map((achievement) => (
                    <li class="flex items-start gap-2 text-small">
                      <Icon class="mt-0.5 text-primary-bright" name="trophy" size={20} />
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">The next one starts in January</Fragment>
      Every robot on this page was designed, machined, wired, and programmed by students. The next one
      needs a team.
      <Button href={nav.cta.href} size="lg" slot="actions">{nav.cta.label}</Button>
      <Button href={programs.frc.href} size="lg" slot="actions" variant="outline">
        About the team
      </Button>
    </CtaBanner>
  </Section>
</ProgramLayout>
