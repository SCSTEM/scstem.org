---
import handsOn from "@/assets/sc2/hands-on-1.webp";
import CtaBanner from "@/components/ui/CtaBanner.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Button from "@/components/ui/primitives/Button.astro";
import ProgramCard from "@/components/ui/ProgramCard.astro";
import Section from "@/components/ui/Section.astro";
import { ogCards } from "@/data/ogCards";
import { nav, programs, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  description={`${programs.fll.name} for ages ${programs.fll.ages} and ${programs.frc.name} for ages ${programs.frc.ages}, run out of one workshop in downtown Chambersburg.`}
  og={ogCards.programs}
  title="Programs"
  trail={[{ name: nav.programs.label, path: nav.programs.href }]}
>
  <Hero>
    <HeroImage
      alt="A student and a mentor working on a robot together at the bench"
      slot="media"
      src={handsOn}
    />
    <Fragment slot="title">
      From LEGO® bricks to <span class="highlight-swipe">120-pound</span> robots
    </Fragment>
    Two <FirstMark /> programs under one roof in downtown Chambersburg, run by the {site.name}.
    {programs.frc.teamName} has competed since {programs.frc.since}; {site.shortName} became its own
    nonprofit in {site.founded}.
    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">Pick where to start</Fragment>
    <Fragment slot="intro">
      Start with your student&rsquo;s age. Where the age ranges overlap, students choose whichever
      program they&rsquo;re most comfortable in.
    </Fragment>

    <FeatureGrid columns={2}>
      <ProgramCard program="fll">
        <p>
          Several small teams, each building a LEGO® robot to run missions on a themed table and
          researching a real problem to solve. It is the shortest route from &ldquo;I like building
          things&rdquo; to standing in front of judges with something you made.
        </p>
        <p class="mt-3">
          Same workspace and mentors as {programs.frc.teamName}, and plenty of our students started
          with no experience at all.
        </p>
      </ProgramCard>

      <ProgramCard program="frc">
        <p>
          Team {programs.frc.teamNumber} - {programs.frc.teamName} - builds a 120-pound robot each
          winter, from the January game reveal to regional competitions in March. Students run the
          design, the fabrication, the code, the money, and the brand, with mentors who do this for
          a living.
        </p>
        <p class="mt-3">
          Competing since {programs.frc.since}, with a new robot every build season.
        </p>
      </ProgramCard>
    </FeatureGrid>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">Look around first</Fragment>
    <Fragment slot="intro">
      No commitment required. See what we have built and when we meet.
    </Fragment>

    <FeatureGrid columns={3}>
      <FeatureCard cta="See every season" href={nav.robots.href} icon="bot">
        <Fragment slot="title">Every season since {programs.frc.since}</Fragment>
        Each {programs.frc.teamName} season: the game, the robot, where we competed, and what we
        won.
      </FeatureCard>

      <FeatureCard cta="Open the calendar" href={nav.calendar.href} icon="calendar">
        <Fragment slot="title">What is coming up</Fragment>
        Build sessions, competitions, and community events across both programs.
      </FeatureCard>

      <FeatureCard cta="Read about FIRST®" href={site.urls.firstInspires} icon="idea">
        <Fragment slot="title">The wider program</Fragment>
        Both of our programs belong to <FirstMark />, a global organization running student robotics
        from elementary school through high school.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <Section atmosphere="pool">
    <Fragment slot="title">Beyond the two teams</Fragment>
    <Fragment slot="intro">
      Our students take their robots out to schools, community groups, and sponsors across the
      region, and we want to reach students who aren&rsquo;t on a team yet.
    </Fragment>

    <FeatureGrid columns={2}>
      <FeatureCard cta="Request a demonstration" href={nav.contact.href} icon="events">
        <Fragment slot="title">Robot demonstrations</Fragment>
        We bring a competition robot, and the students who built it, to your school, club, or
        company event.
      </FeatureCard>

      <FeatureCard cta="Talk to us about workshops" href={nav.contact.href} icon="education">
        <Fragment slot="title">Workshops, with your help</Fragment>
        We don&rsquo;t run workshops yet. With the right sponsor or volunteers behind them, we would
        like to. If that could be you, let&rsquo;s talk.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">Still deciding which one?</Fragment>
      Tell us the student&rsquo;s age and interests, and we&rsquo;ll point you to the right team.
      Parents and would-be mentors can ask too.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={nav.contact.href} size="lg" slot="actions" variant="secondary">
        Ask a question
      </Button>
    </CtaBanner>
  </Section>
</BaseLayout>
