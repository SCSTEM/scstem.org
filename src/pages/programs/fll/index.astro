---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import CtaBanner from "@/components/ui/CtaBanner.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import JoiningFaq from "@/components/ui/JoiningFaq.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Callout from "@/components/ui/primitives/Callout.astro";
import Section from "@/components/ui/Section.astro";
import { ogCards } from "@/data/ogCards";
import { programPhotos } from "@/data/programPhotos";
import { nav, programs, site } from "@/data/site";
import ProgramLayout from "@/layouts/ProgramLayout.astro";
import { PHOTO_QUALITY } from "@/lib/images";
import { programTrail } from "@/lib/jsonld";

/**
 * The copy is limited to what the site can stand behind: what the program is, the three parts
 * of a season as FIRST defines them, and the teams the content collection knows about. Anything
 * season-specific — dates, fees, meeting nights — routes to the calendar and the get-involved
 * form rather than being stated here.
 */
const teamPhotos = (await getCollection("fllTeamPhotos")).toSorted(
  (a, b) => b.data.year - a.data.year,
);
const latest = teamPhotos[0];
---

<ProgramLayout
  description={`${programs.fll.name} at the ${site.name}: teams of ${programs.fll.ages}-year-olds build a LEGO® robot, research a real problem, and take both to competition.`}
  og={ogCards.fll}
  program="fll"
  title="FIRST LEGO League"
  trail={programTrail("fll")}
>
  <Hero>
    <HeroImage alt={programPhotos.fll.alt} slot="media" src={programPhotos.fll.image} />
    <Fragment slot="eyebrow">Ages {programs.fll.ages}</Fragment>
    <Fragment slot="title">
      Where <span class="highlight-swipe">building</span> turns into engineering
    </Fragment>
    <FirstMark /> LEGO® League is where most of our students start: a small team, a LEGO® robot, a
    table full of missions, and a real problem to go solve.
    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">What the program is</Fragment>
    <Fragment slot="intro">
      Every season <FirstMark /> sets a theme, and teams around the world work the same challenge at
      the same time. Ours meet at the workspace in downtown Chambersburg, alongside the high-school{" "}
      <a href={programs.frc.href}>{programs.frc.name}</a> team &mdash; same mentors, same tools,
      smaller robots.
    </Fragment>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">Three parts to a season</Fragment>
    <Fragment slot="intro">
      A team is judged on all three, which is why there is a job here for someone who would rather
      research, present, or organize than drive.
    </Fragment>

    <FeatureGrid columns={3}>
      <FeatureCard icon="bot">
        <Fragment slot="title">The robot game</Fragment>
        Design, build, and program a LEGO® robot to run missions on a themed table, then run it solo
        in a 2½-minute match.
      </FeatureCard>

      <FeatureCard icon="idea">
        <Fragment slot="title">The innovation project</Fragment>
        Research a real problem connected to the season&rsquo;s theme, work out a solution, and
        pitch it to judges the way an engineer pitches a client.
      </FeatureCard>

      <FeatureCard icon="group">
        <Fragment slot="title">Core values</Fragment>
        How the team works together — discovery, innovation, impact, inclusion, teamwork, and fun.
        It is scored, and it is the part alumni remember.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  {latest !== undefined && (
    <Section atmosphere="pool">
      <Fragment slot="title">Our teams</Fragment>
      <Fragment slot="intro">
        Teams stay small on purpose, so nobody spends the season watching someone else build.
      </Fragment>

      <figure class="mx-auto max-w-3xl">
        <div class="media-frame">
          <Image
            alt={latest.data.alt}
            class="w-full"
            loading="lazy"
            quality={PHOTO_QUALITY}
            sizes="(min-width: 48rem) 48rem, 92vw"
            src={latest.data.photo}
            width={1280}
            widths={[640, 840, 1280]}
          />
        </div>
        {latest.data.caption !== undefined && (
          <Callout as="figcaption" class="mt-3">
            {latest.data.caption}
          </Callout>
        )}
      </figure>
    </Section>
  )}

  <JoiningFaq program="fll" />

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">Start here</Fragment>
      No experience needed, and no LEGO® collection required — the robots, the tools, and the
      mentors are ours. Tell us your student&rsquo;s age and we&rsquo;ll tell you what the next
      season looks like.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={site.urls.firstInspires} size="lg" slot="actions" variant="outline">
        About <FirstMark />
      </Button>
    </CtaBanner>
  </Section>
</ProgramLayout>
