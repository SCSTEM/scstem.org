---
import { getCollection } from "astro:content";

import CtaBanner from "@/components/ui/CtaBanner.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import FirstMark from "@/components/ui/FirstMark.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import JoiningFaq from "@/components/ui/JoiningFaq.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Section from "@/components/ui/Section.astro";
import { ogCards } from "@/data/ogCards";
import { nav, programs, site } from "@/data/site";
import ProgramLayout from "@/layouts/ProgramLayout.astro";
import { programTrail } from "@/lib/jsonld";

const latest = (await getCollection("fllTeamPhotos")).toSorted(
  (a, b) => b.data.year - a.data.year,
)[0]?.data;
if (latest === undefined) {
  throw new Error("fllTeamPhotos: no entry to lead the FLL page with.");
}
---

<ProgramLayout
  description={`${programs.fll.name} for ages ${programs.fll.ages} in downtown Chambersburg: small teams build a LEGO® robot, research a real problem, and present both to judges.`}
  og={ogCards.fll}
  program="fll"
  title="FIRST LEGO League"
  trail={programTrail("fll")}
>
  <Hero>
    <HeroImage alt={latest.alt} slot="media" src={latest.photo} />
    <Fragment slot="eyebrow">Ages {programs.fll.ages}</Fragment>
    <Fragment slot="title">
      Where <span class="highlight-swipe">building</span> turns into engineering
    </Fragment>
    <FirstMark /> LEGO® League is where our youngest students start: a small team, a LEGO® robot, a
    table full of missions, and a real problem to go solve.
    <Button href={nav.cta.href} size="lg" slot="actions">
      {nav.cta.label}
    </Button>
  </Hero>

  <Section atmosphere="bubble" index={1}>
    <Fragment slot="title">Three parts to a season</Fragment>
    <Fragment slot="intro">
      Every season <FirstMark /> sets a new theme, and{" "}
      <a class="external-link" href={site.urls.firstInspires} rel="noopener">
        teams around the world
      </a>{" "}
      take on the same challenge at the same time. The top awards weigh all three parts, so there is
      a job here for someone who would rather research, present, or organize than drive.
    </Fragment>

    <FeatureGrid columns={3}>
      <FeatureCard icon="bot">
        <Fragment slot="title">The robot game</Fragment>
        Design, build, and program a LEGO® robot that runs missions on a themed table by itself in a
        2½-minute match, then walk the judges through how you designed it.
      </FeatureCard>

      <FeatureCard icon="idea">
        <Fragment slot="title">The innovation project</Fragment>
        Research a real problem connected to the season&rsquo;s theme, work out a solution, and
        pitch it to judges the way an engineer pitches a client.
      </FeatureCard>

      <FeatureCard icon="group">
        <Fragment slot="title">Core values</Fragment>
        How the team works together: discovery, innovation, impact, inclusion, teamwork, and fun.
        Judges look for it across the whole event, not in one session.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <Section atmosphere="band">
    <Fragment slot="title">How our teams work</Fragment>
    <Fragment slot="intro">
      We run several <FirstMark /> LEGO® League teams, each small on purpose so nobody spends the
      season watching someone else build.
    </Fragment>

    <FeatureGrid columns={2}>
      <FeatureCard cta="Get directions" href={site.urls.directions} icon="location">
        <Fragment slot="title">Downtown Chambersburg</Fragment>
        Every team shares a workspace with {programs.frc.teamName}: same mentors, same tools,
        smaller robots. Find us at {site.location.street}, downtown.
      </FeatureCard>

      <FeatureCard icon="wallet">
        <Fragment slot="title">{programs.fll.cost}</Fragment>
        Families cover the extras, like a team shirt or a hotel night at an away event. Sponsors
        cover the rest.
      </FeatureCard>

      <FeatureCard icon="security">
        <Fragment slot="title">Two adults, always</Fragment>
        Two-deep supervision at every meeting and event, under Pennsylvania and <FirstMark />
        youth-protection guidelines.
      </FeatureCard>

      <FeatureCard icon="direction--fork">
        <Fragment slot="title">Old enough for both?</Fragment>
        Where the age ranges overlap, students choose whichever program they&rsquo;re most
        comfortable in: this one or <a href={programs.frc.href}>{programs.frc.teamName}</a>.
      </FeatureCard>
    </FeatureGrid>
  </Section>

  <JoiningFaq program="fll" />

  <Section atmosphere="ruler">
    <CtaBanner>
      <Fragment slot="title">Start here</Fragment>
      No LEGO® collection required: the robots, the tools, and the mentors are ours. Tell us your
      student&rsquo;s age and we&rsquo;ll tell you what the next season looks like.
      <Button href={nav.cta.href} size="lg" slot="actions">
        {nav.cta.label}
      </Button>
      <Button href={nav.calendar.href} size="lg" slot="actions" variant="secondary">
        See when teams meet
      </Button>
    </CtaBanner>
  </Section>
</ProgramLayout>
