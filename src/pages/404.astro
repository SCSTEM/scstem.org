---
import FeatureCard from "@/components/ui/FeatureCard.astro";
import FeatureGrid from "@/components/ui/FeatureGrid.astro";
import Hero from "@/components/ui/Hero.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Section from "@/components/ui/Section.astro";
import { nav, programs } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * Cloudflare Pages serves `404.html` from static output automatically, so this needs no config.
 * Noindexed, and useful rather than cute: the links are the four places people were most likely
 * headed. It is a blueprint page (DESIGN.md §2): the sheet that is not in the set.
 */

/** Titles and hrefs are the nav inventory's, so a renamed or moved route follows here. */
const destinations = [
  {
    ...nav.programs,
    icon: "bot",
    cta: "See our programs",
    description: "FIRST LEGO League and FIRST Robotics Competition.",
  },
  {
    ...nav.about,
    icon: "information",
    cta: "Read about us",
    description: `Who we are and what we’ve built since ${String(programs.frc.since)}.`,
  },
  {
    ...nav.sponsors,
    icon: "enterprise",
    cta: "See our sponsors",
    description: "The businesses that make this possible.",
  },
  { ...nav.contact, icon: "email", cta: "Contact us", description: "Ask us anything." },
];
---

<BaseLayout
  description="That page does not exist. Here are the places you were most likely headed."
  noindex
  register="blueprint"
  title="Page not found"
>
  <Hero>
    <Fragment slot="eyebrow">Error 404</Fragment>
    <Fragment slot="title">We can't find that page</Fragment>

    <p>It may have moved, or the link may be out of date. Try one of these instead.</p>
  </Hero>

  <Section atmosphere="pool" srTitle="Where to go instead">
    <FeatureGrid columns={2}>
      {destinations.map((destination) => (
        <FeatureCard cta={destination.cta} href={destination.href} icon={destination.icon}>
          <Fragment slot="title">{destination.label}</Fragment>
          {destination.description}
        </FeatureCard>
      ))}
    </FeatureGrid>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/">Back to the homepage</Button>
      <Button href={nav.cta.href} variant="secondary">
        {nav.cta.label}
      </Button>
    </div>
  </Section>
</BaseLayout>
