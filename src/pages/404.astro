---
import Hero from "@/components/ui/Hero.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Card from "@/components/ui/primitives/Card.astro";
import CardDescription from "@/components/ui/primitives/CardDescription.astro";
import CardHeader from "@/components/ui/primitives/CardHeader.astro";
import CardTitle from "@/components/ui/primitives/CardTitle.astro";
import Section from "@/components/ui/Section.astro";
import { nav } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * Cloudflare Pages serves `404.html` from static output automatically, so this needs no config.
 * Noindexed, and useful rather than cute: the links are the four places people were most likely
 * headed.
 */

/** Titles and hrefs are the nav inventory's, so a renamed or moved route follows here. */
const destinations = [
  { ...nav.programs, description: "FIRST LEGO League and FIRST Robotics Competition." },
  { ...nav.about, description: "Who we are and what we have built since 2013." },
  { ...nav.sponsors, description: "The businesses that make this possible." },
  { ...nav.contact, description: "Ask us anything — we answer." },
];
---

<BaseLayout
  description="That page does not exist. Here are the places you were most likely headed."
  noindex
  title="Page not found"
>
  <Hero>
    <Fragment slot="eyebrow">Error 404</Fragment>
    <Fragment slot="title">We can't find that page</Fragment>

    <p>It may have moved, or the link may be out of date. Try one of these instead.</p>
  </Hero>

  <Section atmosphere="pool">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        destinations.map((destination) => (
          <Card as="article" interactive>
            <CardHeader>
              {/* `h2`: the page's only other heading is its `h1`, and the default `h3` skips a level. */}
              <CardTitle as="h2">
                <a class="ui-link" href={destination.href}>
                  {destination.label}
                </a>
              </CardTitle>
              <CardDescription>{destination.description}</CardDescription>
            </CardHeader>
          </Card>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/">Back to the homepage</Button>
      <Button href={nav.cta.href} variant="outline">{nav.cta.label}</Button>
    </div>
  </Section>
</BaseLayout>
