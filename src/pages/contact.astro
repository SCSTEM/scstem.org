---
import { Image } from "astro:assets";

import laptop from "@/assets/sc2/laptop.webp";
import ContactForm from "@/components/ui/ContactForm.astro";
import Hero from "@/components/ui/Hero.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Card from "@/components/ui/primitives/Card.astro";
import CardContent from "@/components/ui/primitives/CardContent.astro";
import CardHeader from "@/components/ui/primitives/CardHeader.astro";
import CardTitle from "@/components/ui/primitives/CardTitle.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import TitleBlock from "@/components/ui/primitives/TitleBlock.astro";
import Section from "@/components/ui/Section.astro";
import { site, socials } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * Legacy's page was a heading and the form. The form is the same funnel — same endpoint, same
 * `Contact Us` label on the Slack message — rebuilt on the primitives; what is new is the
 * sidebar, which answers "who am I writing to and where are they" without a round trip. It uses
 * the boxed title block DESIGN.md §2.9 sanctions for exactly this page.
 */
const fields = [
  { label: "Organization", value: site.name },
  { label: "Workspace", value: site.location.workspace },
  { label: "Serving", value: site.location.areaServed },
  { href: `mailto:${site.email}`, label: "Email", mono: true, value: site.email },
];
---

<BaseLayout
  description="Questions about a program, a sponsorship, or getting your student started? Send the South Central STEM Collective a message."
  title="Contact"
>
  <Hero>
    <Image
      alt="A student working at a laptop in the South Central STEM Collective workspace"
      class="h-full w-full object-cover"
      fetchpriority="high"
      loading="eager"
      sizes="100vw"
      slot="media"
      src={laptop}
      widths={[640, 960, 1280, 1920]}
    />

    <Fragment slot="title">Contact us</Fragment>

    Questions about a program, a sponsorship, or getting your student started? Send us a note and a
    real person will answer.
  </Hero>

  <Section atmosphere="pool-neutral">
    <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <div>
        <h2 class="sr-only">Send us a message</h2>
        <ContactForm name="Contact Us" />
      </div>

      <div class="flex flex-col gap-6">
        <TitleBlock {fields} orientation="stack" />

        <Card>
          <CardHeader>
            <CardTitle rule>Visit the workspace</CardTitle>
          </CardHeader>
          <CardContent class="flex flex-col items-start gap-4">
            <p>
              We are in downtown Chambersburg. Directions, parking, and door details live on the
              wiki.
            </p>
            <Button
              class="external-link -ml-3"
              href={site.urls.directions}
              rel="noopener"
              variant="link"
            >
              Directions to the workspace
            </Button>
          </CardContent>
        </Card>

        <div>
          <h3 class="text-h4 text-foreground font-sans font-semibold">Find us online</h3>
          <ul class="mt-3 flex gap-2">
            {
              socials.map((social) => (
                <li>
                  <Button
                    class="hover:bg-card-hover"
                    href={social.href}
                    rel="noopener"
                    size="icon"
                    variant="ghost"
                  >
                    <Icon label={social.label} name={social.icon} size={24} />
                  </Button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
