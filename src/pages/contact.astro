---
import laptop from "@/assets/sc2/laptop.webp";
import ContactForm from "@/components/ui/ContactForm.astro";
import Hero from "@/components/ui/Hero.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import Card from "@/components/ui/primitives/Card.astro";
import CardContent from "@/components/ui/primitives/CardContent.astro";
import CardHeader from "@/components/ui/primitives/CardHeader.astro";
import CardTitle from "@/components/ui/primitives/CardTitle.astro";
import Link from "@/components/ui/primitives/Link.astro";
import TitleBlock from "@/components/ui/primitives/TitleBlock.astro";
import Section from "@/components/ui/Section.astro";
import SocialLinks from "@/components/ui/SocialLinks.astro";
import { nav, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const fields = [
  { label: "Organization", value: site.name },
  { label: "Workspace", value: site.location.workspace },
  { label: "Community", value: site.location.areaServed },
  { href: `mailto:${site.email}`, label: "Email", mono: true, value: site.email },
];
---

<BaseLayout
  description="Questions, sponsorships, or a robot demonstration for your school, group, or event? Send the South Central STEM Collective a message."
  title="Contact"
  trail={[{ name: nav.contact.label, path: nav.contact.href }]}
>
  <Hero>
    <HeroImage
      alt="A laptop displaying a spreadsheet of the team meeting calendar"
      caption="Planning team meetings"
      slot="media"
      src={laptop}
    />
    <Fragment slot="title">Contact us</Fragment>
    Send us your questions about a program, sponsorship, or robot demonstration, and a volunteer
    will reply by email. If you&rsquo;re interested in joining a team, our{" "}
    <Link href={nav.cta.href}>{nav.cta.label} form</Link> helps us learn about your interests.
  </Hero>

  <Section atmosphere="pool-neutral" srTitle="Send us a message">
    <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <div>
        <ContactForm name="Contact Us" />
      </div>

      <div class="flex flex-col gap-6">
        <TitleBlock {fields} orientation="stack" />

        <Card>
          <CardHeader>
            <CardTitle rule>Robot demonstrations</CardTitle>
          </CardHeader>
          <CardContent>
            <p>
              To invite our students and robots to your school, group, or event, share the date,
              location, and audience so we can discuss what our teams can bring.
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle rule>Visit the workspace</CardTitle>
          </CardHeader>
          <CardContent class="flex flex-col items-start gap-4">
            <p>
              Get in touch to arrange a visit to our downtown {site.location.locality},{" "}
              {site.location.region} workspace. We welcome students and families from{" "}
              {site.location.county} and beyond.
            </p>
            <p>
              <Link href={site.urls.directions}>Directions to the workspace</Link>
            </p>
          </CardContent>
        </Card>

        <div>
          <CardTitle>Find us online</CardTitle>
          <SocialLinks class="mt-3" />
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
