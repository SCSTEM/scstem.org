<script>
  /**
   * The preview panel's three switches (section 02). Each sets one attribute on the panel, and
   * the tokens do the rest; the unset accent and register are the defaults.
   */
  const panel = document.querySelector<HTMLElement>("[data-preview]");
  const readout = document.querySelector("[data-preview-attrs]");

  const describe = (element: HTMLElement): string =>
    ["mode", "accent", "register"]
      .flatMap((name) => {
        const value = element.dataset[name];
        return value === undefined ? [] : [`data-${name}="${value}"`];
      })
      .join(" ");

  if (panel !== null) {
    for (const choice of document.querySelectorAll<HTMLButtonElement>("[data-preview-choice]")) {
      choice.addEventListener("click", () => {
        const attr = choice.dataset.attr;
        const value = choice.dataset.value;
        if (attr === undefined || value === undefined) {
          return;
        }
        if (value === "") {
          panel.removeAttribute(`data-${attr}`);
        } else {
          panel.dataset[attr] = value;
        }
        for (const sibling of document.querySelectorAll<HTMLButtonElement>(
          `[data-preview-choice][data-attr="${attr}"]`,
        )) {
          sibling.setAttribute("aria-pressed", String(sibling === choice));
        }
        if (readout !== null) {
          readout.textContent = describe(panel);
        }
      });
    }
  }
</script>
