---
import Hero from "@/components/ui/Hero.astro";
import Badge from "@/components/ui/primitives/Badge.astro";
import Button from "@/components/ui/primitives/Button.astro";
import Callout from "@/components/ui/primitives/Callout.astro";
import Card from "@/components/ui/primitives/Card.astro";
import CardContent from "@/components/ui/primitives/CardContent.astro";
import CardDescription from "@/components/ui/primitives/CardDescription.astro";
import CardFooter from "@/components/ui/primitives/CardFooter.astro";
import CardHeader from "@/components/ui/primitives/CardHeader.astro";
import CardTitle from "@/components/ui/primitives/CardTitle.astro";
import ChalkOval from "@/components/ui/primitives/ChalkOval.astro";
import FieldError from "@/components/ui/primitives/FieldError.astro";
import Icon from "@/components/ui/primitives/Icon.astro";
import Input from "@/components/ui/primitives/Input.astro";
import Label from "@/components/ui/primitives/Label.astro";
import RegistrationMarks from "@/components/ui/primitives/RegistrationMarks.astro";
import RevisionCloud from "@/components/ui/primitives/RevisionCloud.astro";
import SketchArrow from "@/components/ui/primitives/SketchArrow.astro";
import StrikeCorrect from "@/components/ui/primitives/StrikeCorrect.astro";
import TitleBlock from "@/components/ui/primitives/TitleBlock.astro";
import Section from "@/components/ui/Section.astro";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cn } from "@/lib/cn";
import { handwritingClass } from "@/lib/hand";

/**
 * The design language, written for the people who build with it: what the SC2 look is, which
 * token or component to reach for, and how the pieces combine, with live examples. A draft of
 * the team wiki's design pages, so it is noindexed (and `_headers` repeats that for the path)
 * and linked from nowhere. DESIGN.md stays the source of truth; `/styleguide` is the proof page
 * with every token and contrast ratio.
 *
 * Each top-level section is one future wiki page.
 */

const sections = [
  { id: "idea", title: "The idea" },
  { id: "switches", title: "Three switches" },
  { id: "tokens", title: "Which token?" },
  { id: "type", title: "Type" },
  { id: "space", title: "Space and radius" },
  { id: "depth", title: "Surfaces and depth" },
  { id: "components", title: "Components" },
  { id: "marker", title: "The marker" },
  { id: "blueprint", title: "The blueprint register" },
  { id: "recipes", title: "Recipes" },
  { id: "checklist", title: "Before you ship" },
];

/** "If you are placing …, use …": the token decisions a new page actually makes. */
const tokenChoices = [
  {
    group: "Text",
    rows: [
      ["A heading, a nav item, emphasis", "foreground", "text-foreground"],
      ["Any paragraph or list someone reads", "body", "text-body"],
      ["A caption, a date, a label — never a paragraph", "muted", "text-muted"],
      ["A link, a key word, an icon, a stat", "primary-bright", "text-primary-bright"],
    ],
  },
  {
    group: "Surfaces",
    rows: [
      ["The page itself", "background", "bg-background"],
      ["A card, panel or field cut into the page", "card", "pocket (utility)"],
      ["A full-width section that should read as a table", "band", 'Section atmosphere="band"'],
      ["A card inside a band", "plate", "automatic: a pocket in a band"],
    ],
  },
  {
    group: "Accent",
    rows: [
      ["A button, a rule, a filled mark", "primary", "bg-primary text-primary-foreground"],
      ["Text or an icon in the accent", "primary-bright", "text-primary-bright"],
      ["A hand-drawn stroke", "mark", "text-mark (the hand primitives set it)"],
    ],
  },
];

const typeRoles = [
  { role: "display", use: "The hero heading only", class: "text-display font-display font-bold" },
  { role: "h1", use: "A page's one title", class: "text-h1 font-display font-bold" },
  { role: "h2", use: "A section heading", class: "text-h2 font-display font-semibold" },
  { role: "h3", use: "A sub-section heading", class: "text-h3 font-display font-semibold" },
  { role: "h4", use: "Card titles, subheads", class: "text-h4 font-semibold text-foreground" },
  { role: "lead", use: "A section's intro paragraph", class: "text-lead" },
  { role: "copy", use: "Everything people read", class: "text-copy" },
  { role: "small", use: "Captions, meta, dense cards", class: "text-small" },
  { role: "label", use: "Eyebrows, chips, spec labels", class: "spec-label" },
];

const spaceSteps = [
  { step: 1, px: 4 },
  { step: 2, px: 8 },
  { step: 3, px: 12 },
  { step: 4, px: 16 },
  { step: 6, px: 24 },
  { step: 8, px: 32 },
  { step: 12, px: 48 },
  { step: 16, px: 64 },
  { step: 24, px: 96 },
];

const iconSamples = ["bot", "calendar", "tools", "trophy", "email", "launch", "logo--github"];

const switchCode = `<!-- The whole page: the light finish, in Biohazard green. -->
<html data-mode="light" data-accent="green">

<!-- Or any element: a dark island on a light page. -->
<section data-mode="dark">…</section>

<!-- The wiki or an app, without Tailwind: -->
<link rel="stylesheet" href="tokens.css" />
.panel { background: var(--sc2-card); color: var(--sc2-body); }`;

const eventRecipe = `<RevisionCloud revision={2}>
  <Card>
    <CardHeader>
      <Badge tone="info">Jan 10, 2027</Badge>
      <CardTitle>Kickoff at the workshop</CardTitle>
    </CardHeader>
  </Card>
</RevisionCloud>
<span class={handwritingClass}>moved up a week</span>`;

const sectionRecipe = `<Section atmosphere="bubble" index={2}>
  <Fragment slot="eyebrow">Ages 14–18</Fragment>
  <Fragment slot="title">Build season starts in January</Fragment>
  <Card feature class="relative">
    <RegistrationMarks />
    …
    <ChalkOval around="control" variant={3}>
      <Button href="/get-involved/">Get involved</Button>
    </ChalkOval>
  </Card>
</Section>`;

const logoRecipe = `<!-- Drawn for a dark ground: it keeps that ground in the light finish. -->
<img class="rounded-md bg-print p-3" src={logo.src} alt="Volvo logo" />`;

/** A preview switch: the label type, filled with the accent while pressed. */
const choiceClass =
  "min-h-11 rounded-md border border-control-edge bg-sheet px-3 spec-label text-foreground aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground";

const checklist = [
  "Every text token is the right role: body for reading, muted only for captions.",
  "One action accent per view; blue only for information.",
  "Every link has its underline; nothing that isn't a link does.",
  "At most four devices in any viewport (links don't count).",
  "It works in both finishes: flip the toggle in the header and look again.",
  "Headings go h1 → h2 → h3 with no skipped level, in sentence case.",
  "Every interactive element shows the focus ring and is 44px or larger to tap.",
  "Photos have honest alt text; decorative marks are hidden from assistive tech.",
  "pnpm check passes, and /styleguide builds (it fails on a contrast regression).",
];
---

<BaseLayout
  description="The SC2 design language for the people who build with it: the look, the tokens, the components and how they combine, with live examples."
  noindex
  title="Design language"
>
  <Hero>
    <Fragment slot="eyebrow">For builders · draft for the team wiki</Fragment>
    <Fragment slot="title">The SC2 design language</Fragment>

    <p>
      How the South Central STEM Collective looks on screen, and how to build with it: which token
      to reach for, which component fits, and how the pieces combine. Everything below is live, so
      it follows the finish toggle in the header.
    </p>
  </Hero>

  <Section srTitle="On this page">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="measure">
        <p>
          <a href="https://github.com/SCSTEM/scstem.org/blob/astro/DESIGN.md">DESIGN.md</a> is the
          source of truth, and <a href="/styleguide/">the styleguide</a> proves every token and
          contrast ratio. This page is the guide in between. It shows every device at once, so it
          breaks the four-per-view budget on purpose; a real page never does.
        </p>
      </div>
      <nav aria-label="On this page" class="pocket p-6">
        <p class="spec-label text-muted">On this page</p>
        <ol class="mt-3 grid gap-1 text-small">
          {sections.map((section, index) => (
            <li class="flex gap-3">
              <span class="font-mono text-muted">{String(index + 1).padStart(2, "0")}</span>
              <a class="ui-link" href={`#${section.id}`}>
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </Section>

  <Section atmosphere="bubble" id="idea" index={1}>
    <Fragment slot="eyebrow">01 · The idea</Fragment>
    <Fragment slot="title">A build document, marked up</Fragment>
    <Fragment slot="intro">
      <p>
        Every SC2 screen is a sheet of material with a drawing on it and an engineer's notes over
        the top. Three layers, and each has its own rules.
      </p>
    </Fragment>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <Card>
        <CardHeader>
          <CardTitle rule>Machined</CardTitle>
          <CardDescription>
            The sheet: pockets cut into it, plates laid on a table, keycaps with drafted edges.
            Perfectly geometric, always.
          </CardDescription>
        </CardHeader>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle rule>Scribed</CardTitle>
          <CardDescription>
            The drawing printed onto it: grids, grid bubbles, title blocks, callouts. Fine lines in
            the data font.
          </CardDescription>
        </CardHeader>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle rule>Marked up</CardTitle>
          <CardDescription>
            The engineer's felt marker: <span class="highlight-swipe">swipes</span>, ovals,
            underlines, arrows and clouds. A few strokes that mean something.
          </CardDescription>
        </CardHeader>
      </Card>
    </div>
  </Section>

  <Section atmosphere="bubble" id="switches" index={2}>
    <Fragment slot="eyebrow">02 · Three switches</Fragment>
    <Fragment slot="title">One part, any finish</Fragment>
    <Fragment slot="intro">
      <p>
        Components read tokens and nothing else, so three attributes change the whole look: the
        finish, the accent, and the register. Try them on the panel.
      </p>
    </Fragment>

    <div class="flex flex-wrap gap-x-8 gap-y-4" data-preview-controls>
      <div aria-label="Finish" class="flex items-center gap-3" role="group">
        <span class="w-20 spec-label text-muted">Finish</span>
        <div class="flex gap-2">
          <button
            aria-pressed="true"
            class={choiceClass}
            data-preview-choice
            data-attr="mode"
            data-value="dark"
            type="button"
          >
            Dark
          </button>
          <button
            aria-pressed="false"
            class={choiceClass}
            data-preview-choice
            data-attr="mode"
            data-value="light"
            type="button"
          >
            Light
          </button>
        </div>
      </div>
      <div aria-label="Accent" class="flex items-center gap-3" role="group">
        <span class="w-20 spec-label text-muted">Accent</span>
        <div class="flex gap-2">
          <button
            aria-pressed="true"
            class={choiceClass}
            data-preview-choice
            data-attr="accent"
            data-value=""
            type="button"
          >
            Yellow
          </button>
          <button
            aria-pressed="false"
            class={choiceClass}
            data-preview-choice
            data-attr="accent"
            data-value="green"
            type="button"
          >
            Green
          </button>
          <button
            aria-pressed="false"
            class={choiceClass}
            data-preview-choice
            data-attr="accent"
            data-value="orange"
            type="button"
          >
            Orange
          </button>
        </div>
      </div>
      <div aria-label="Register" class="flex items-center gap-3" role="group">
        <span class="w-20 spec-label text-muted">Register</span>
        <div class="flex gap-2">
          <button
            aria-pressed="true"
            class={choiceClass}
            data-preview-choice
            data-attr="register"
            data-value=""
            type="button"
          >
            Shop
          </button>
          <button
            aria-pressed="false"
            class={choiceClass}
            data-preview-choice
            data-attr="register"
            data-value="blueprint"
            type="button"
          >
            Blueprint
          </button>
        </div>
      </div>
    </div>

    <div
      class="mt-6 rounded-lg border border-border bg-background bg-(image:--sc2-texture-grain) p-6 text-body md:p-10"
      data-mode="dark"
      data-preview
    >
      <p class="spec-label text-primary-bright">Ages 14–18 · Franklin County</p>
      <p class="mt-2 font-display text-h2 font-semibold text-foreground">
        Real robots, built <span class="highlight-swipe">right here</span>.
      </p>
      <p class="mt-4 measure">
        Teams meet Saturdays at the workshop. Check <a href="/calendar/">the calendar</a> for dates,
        or <a href="/programs/">read about our programs</a>.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <Card>
          <CardHeader>
            <div class="flex items-start justify-between gap-3">
              <CardTitle rule>
                <i>FIRST</i>® Robotics Competition
              </CardTitle>
              <Badge>Ages 14–18</Badge>
            </div>
            <CardDescription>A 120-pound robot, six weeks, and one rulebook.</CardDescription>
          </CardHeader>
        </Card>
        <Card>
          <CardContent class="pt-6">
            <p class="spec-label text-muted">Years on the field</p>
            <p class="mt-1 stat">14+</p>
          </CardContent>
        </Card>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/get-involved/">Get involved</Button>
        <Button href="/donate/" variant="outline">
          Donate
        </Button>
      </div>
    </div>

    <p class="mt-6 font-mono text-small text-muted" data-preview-attrs>
      data-mode="dark"
    </p>

    <pre class="mt-6 overflow-x-auto pocket p-5 font-mono text-small text-body"><code>{switchCode}</code></pre>
  </Section>

  <Section atmosphere="bubble" id="tokens" index={3}>
    <Fragment slot="eyebrow">03 · Which token?</Fragment>
    <Fragment slot="title">Start from what the thing is</Fragment>
    <Fragment slot="intro">
      <p>
        You never pick a color, only a role. Each row names the role, the token, and what to write
        on this site. On the wiki or in an app, the same token is{" "}
        <code class="font-mono text-foreground">var(--sc2-…)</code>.
      </p>
    </Fragment>

    <div class="grid grid-cols-1 gap-8">
      {tokenChoices.map((group) => (
        <div>
          <h3 class="text-h4">{group.group}</h3>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-160 border-collapse text-small">
              <thead>
                <tr class="border-b border-border text-left">
                  <th class="py-2 pr-4 spec-label text-muted">If you are placing</th>
                  <th class="py-2 pr-4 spec-label text-muted">Token</th>
                  <th class="py-2 spec-label text-muted">On this site</th>
                </tr>
              </thead>
              <tbody>
                {group.rows.map(([use, token, css]) => (
                  <tr class="border-b border-border/60">
                    <td class="py-3 pr-4">{use}</td>
                    <td class="py-3 pr-4 font-mono text-foreground">{token}</td>
                    <td class="py-3 font-mono text-muted">{css}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section atmosphere="bubble" id="type" index={4}>
    <Fragment slot="eyebrow">04 · Type</Fragment>
    <Fragment slot="title">Nine roles, three line heights</Fragment>
    <Fragment slot="intro">
      <p>
        Pick the role the text plays; its size, leading and font follow. Orbitron is for headings
        only, Source Code Pro for every number and label, Inter for everything else, and the hand
        for five-word notes.
      </p>
    </Fragment>

    <div class="divide-y divide-border">
      {typeRoles.map((entry) => (
        <div class="grid grid-cols-1 gap-2 py-5 md:grid-cols-[10rem_minmax(0,1fr)] md:items-baseline md:gap-6">
          <div>
            <p class="font-mono text-small text-foreground">{entry.role}</p>
            <p class="text-small text-muted">{entry.use}</p>
          </div>
          <p class={cn(entry.class, "min-w-0 text-foreground")}>The workshop opens at nine</p>
        </div>
      ))}
      <div class="grid grid-cols-1 gap-2 py-5 md:grid-cols-[10rem_minmax(0,1fr)] md:items-baseline md:gap-6">
        <div>
          <p class="font-mono text-small text-foreground">stat</p>
          <p class="text-small text-muted">A number that is the point</p>
        </div>
        <p class="stat">1,240</p>
      </div>
      <div class="grid grid-cols-1 gap-2 py-5 md:grid-cols-[10rem_minmax(0,1fr)] md:items-baseline md:gap-6">
        <div>
          <p class="font-mono text-small text-foreground">hand</p>
          <p class="text-small text-muted">A note, five words at most</p>
        </div>
        <p class={cn(handwritingClass, "text-lead")}>start here!</p>
      </div>
    </div>
  </Section>

  <Section atmosphere="bubble" id="space" index={5}>
    <Fragment slot="eyebrow">05 · Space and radius</Fragment>
    <Fragment slot="title">Nine steps and three corners</Fragment>
    <Fragment slot="intro">
      <p>
        Spacing comes from nine steps, named by their Tailwind numbers. Other values are allowed
        when a layout needs one, but they are the exception a reviewer asks about. Radius follows
        the kind of object.
      </p>
    </Fragment>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h3 class="text-h4">Spacing</h3>
        <ul class="mt-4 grid gap-2">
          {spaceSteps.map((entry) => (
            <li class="grid grid-cols-[6rem_minmax(0,1fr)] items-center gap-4">
              <span class="text-right font-mono text-small text-muted">
                {entry.step} · {entry.px}px
              </span>
              <span class="h-3 rounded-sm bg-primary/70" style={`width: ${String(entry.px)}px`} />
            </li>
          ))}
        </ul>
        <dl class="mt-6 grid gap-3 text-small">
          <div>
            <dt class="font-semibold text-foreground">Inside a component</dt>
            <dd>8 · 12 · 16 · 24. Cards are 24 inside; chips 4 × 8.</dd>
          </div>
          <div>
            <dt class="font-semibold text-foreground">Between components</dt>
            <dd>24 · 32 · 48.</dd>
          </div>
          <div>
            <dt class="font-semibold text-foreground">Sections</dt>
            <dd>
              64 on phones, 96 from tablets up — the <code class="font-mono">section-y</code>{" "}
              utility.
            </dd>
          </div>
        </dl>
      </div>
      <div>
        <h3 class="text-h4">Radius</h3>
        <div class="mt-4 grid gap-6">
          <div class="flex items-center gap-4">
            <Badge>Ages 9–16</Badge>
            <p class="text-small">
              <b class="text-foreground">Stamped, 4px</b> — chips, badges, the icon plate.
            </p>
          </div>
          <div class="flex items-center gap-4">
            <Button size="sm" variant="outline">
              Control
            </Button>
            <p class="text-small">
              <b class="text-foreground">Control, 8px</b> — buttons, inputs, toggles.
            </p>
          </div>
          <div class="flex items-center gap-4">
            <div class="size-16 shrink-0 pocket"></div>
            <p class="text-small">
              <b class="text-foreground">Cut, 12px</b> — pockets, plates, panels, photos.
            </p>
          </div>
          <p class="text-small text-muted">
            Nested corners: the inner radius is the outer minus the inset, never below 4px. No
            pills, ever — a circled word is a marker oval.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section atmosphere="bubble" id="depth" index={6}>
    <Fragment slot="eyebrow">06 · Surfaces and depth</Fragment>
    <Fragment slot="title">Cut into the sheet, laid on the table</Fragment>
    <Fragment slot="intro">
      <p>
        On the page, cards are pockets cut down into the sheet, with a lit floor. Inside a band, the
        same card rises as a plate. What stands up — a button, a framed photo — casts a hard,
        drafted edge down and to the right. Nothing glows and nothing floats.
      </p>
    </Fragment>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <Card>
        <CardHeader>
          <CardTitle>Pocket</CardTitle>
          <CardDescription>
            The default card. Darker than the page, lit toward its lip.
          </CardDescription>
        </CardHeader>
      </Card>
      <Card interactive>
        <CardHeader>
          <CardTitle>Interactive pocket</CardTitle>
          <CardDescription>
            Hover it: the border warms and the floor lifts. It never moves.
          </CardDescription>
        </CardHeader>
      </Card>
      <Card class="relative" feature>
        <RegistrationMarks />
        <CardHeader>
          <CardTitle>Feature pocket</CardTitle>
          <CardDescription>
            A grid floor and construction lines, for the one moment a view wants noticed.
          </CardDescription>
        </CardHeader>
      </Card>
    </div>

    <div class="band mt-10 overflow-hidden rounded-lg px-6 py-10 md:px-10">
      <p class="measure">
        A band is the drafting table: a full-width section with a grid of its own. The same card
        inside it is a raised plate.
      </p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <Card>
          <CardHeader>
            <CardTitle>Plate</CardTitle>
            <CardDescription>Lighter than the table, with a soft contact shadow.</CardDescription>
          </CardHeader>
        </Card>
        <Card interactive>
          <CardHeader>
            <CardTitle>Interactive plate</CardTitle>
            <CardDescription>Two bands never touch, and the footer is one.</CardDescription>
          </CardHeader>
        </Card>
      </div>
    </div>
  </Section>

  <Section atmosphere="bubble" id="components" index={7}>
    <Fragment slot="eyebrow">07 · Components</Fragment>
    <Fragment slot="title">The pieces, and when to use each</Fragment>

    <div class="grid grid-cols-1 gap-12">
      <div>
        <h3 class="text-h3">Buttons are keycaps</h3>
        <p class="mt-2 measure">
          One primary per region: the thing the page wants done. Outline for the second action.
          Ghost and secondary for quiet controls. A link that does something is a button; a button
          that goes somewhere can be a link.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <Button>Primary</Button>
          <Button variant="outline">Outline</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="ghost">Ghost</Button>
          <Button size="icon" variant="outline">
            <Icon label="Next" name="chevron--right" size={20} />
          </Button>
        </div>
      </div>

      <div>
        <h3 class="text-h3">Links come in three forms</h3>
        <ul class="mt-4 grid gap-3 measure">
          <li>
            <b class="text-foreground">In copy</b> — the marker underline:{" "}
            <a href="/about/">who we are</a>.
          </li>
          <li>
            <b class="text-foreground">In chrome</b> — nav, footer, card footers:{" "}
            <a class="ui-link" href="/sponsors/">
              no stroke at rest
            </a>
            , a straight hairline on hover.
          </li>
          <li>
            <b class="text-foreground">As a reference</b> — a linked logo or figure, with a callout
            naming where it goes.
          </li>
        </ul>
        <Callout class="mt-3" reference="REF">
          firstinspires.org
        </Callout>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <div>
          <h3 class="text-h3">Chips</h3>
          <p class="mt-2">Short facts in the data voice: ages, tiers, dates.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <Badge>Ages 9–16</Badge>
            <Badge tone="info">Jan 10</Badge>
