{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --ignore-certificate-errors",
        "disableFullPageScreenshot": true,
        "blockedUrlPatterns": ["*/video/*"]
      },
      "startServerCommand": "node tools/ci/serve.ts",
      "startServerReadyPattern": "https://localhost:4321",
      "url": [
        "https://localhost:4321/",
        "https://localhost:4321/programs/frc",
        "https://localhost:4321/get-involved",
        "https://localhost:4321/__event-fixture/openhouse"
      ]
    },
    "assert": {
      "aggregationMethod": "pessimistic",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "median" }
        ],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 35840 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 1048576 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
