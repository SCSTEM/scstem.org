amends "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Builtins.pkl"

fail_fast = false

steps {
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["actionlint"] = Builtins.actionlint
  ["mise"] = Builtins.mise
  ["calendar"] {
    glob = List("functions/**/*.ts", "tools/checks/verify-calendar.ts")
    check = new CommandSpec { command = "node tools/checks/verify-calendar.ts"; effect = "read" }
  }
  ["prettier"] = (Builtins.prettier) { batch = false }
  // `--no-warn-ignored` keeps an explicitly passed ignored file from counting against
  // `--max-warnings 0`.
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob = List("**/*.ts", "**/*.mts", "**/*.js", "**/*.mjs", "**/*.astro")
    // Typed rules read the `astro:content` types that `astro check` generates.
    depends = "astro"
    check {
      command {
        argv =
          List("eslint", "--max-warnings", "0", "--no-warn-ignored", "--format", "gha", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("eslint", "--max-warnings", "0", "--no-warn-ignored", "--fix", "{{files}}")
      }
    }
  }

  // Whole-program checks, behind the `slow` profile so the pre-commit and per-edit hooks skip them.
  ["astro"] {
    profiles = List("slow")
    glob = List("src/**", "*.ts", "tsconfig.json")
    // Writes only the generated types in `.astro/`.
    check = new CommandSpec { command = "astro check"; effect = "write" }
  }
  // One `tsc -p` per tsconfig.json; `astro check` covers `src/` and the root config files.
  ["tsc"] = (Builtins.tsc) {
    profiles = List("slow")
    glob = List("functions/**/*.ts", "tools/**/*.ts")
  }
  // Check only: `knip --fix` deletes code.
  ["knip"] {
    profiles = List("slow")
    glob = List("**/*.ts", "**/*.mts", "**/*.js", "**/*.mjs", "**/*.astro", "package.json")
    check = new CommandSpec {
      command = "knip ${GITHUB_ACTIONS:+--reporter github-actions}"
      effect = "read"
    }
  }
}
