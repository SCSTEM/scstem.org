{
  "name": "scstem.org",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run knip",
    "typecheck": "astro check && tsc -p functions && tsc -p tools",
