    "cn": "0.3.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260919.1",
    "@resvg/resvg-js": "2.6.2",
    "@tabler/icons": "3.47.0",
    "@types/node": "26.6.2",
    "@typescript-eslint/utils": "8.70.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.11.1",
    "jiti": "2.7.0",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "satori": "0.33.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
