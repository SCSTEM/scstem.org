{
  "name": "scstem.org",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run knip && pnpm run check:content",
    "typecheck": "astro check && tsc -p functions && tsc -p tools",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --max-warnings 0 --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "knip": "knip",
    "check:content": "node tools/checks/content-references.ts",
    "check:meta": "node tools/checks/verify-meta.ts",
    "assets:optimize": "node tools/assets/optimize-sources.ts",
    "assets:fonts": "node tools/assets/font-subset.ts",
    "assets:og": "node tools/assets/og-cards.ts",
    "assets:og-fonts": "node tools/assets/og-fonts.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.0",
    "@fontsource/architects-daughter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.6",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260825.1",
    "@tabler/icons": "3.46.0",
    "@types/node": "26.3.0",
    "@typescript-eslint/utils": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.10.1",
    "jiti": "2.7.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
