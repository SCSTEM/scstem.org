{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**",
    "functions/**",
    // The single sanctioned import site for `cn` (see .oxlintrc.json's import ban).
    // Components consume it from Phase 03 onward; it is a seam, not dead code.
    "src/lib/cn.ts",
  ],
  "project": ["**/*.{ts,tsx,js,mjs,cjs,astro}"],
  "ignore": ["legacy/**", "tools/lint/anti-slop/**"],
  // Consumed by `@import "tailwindcss"` in src/styles/global.css. knip does not
  // follow imports inside compiled extensions, so it cannot see the reference.
  "ignoreDependencies": ["tailwindcss"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error",
  },
}
