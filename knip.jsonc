{
  "$schema": "./node_modules/knip/schema.json",
  // Cloudflare Pages Functions are file-routed, which knip has no plugin for; Lighthouse CI
  // starts tools/ci/serve.ts from lighthouserc.json, which knip does not read.
  "entry": ["functions/**/*.ts", "tools/ci/serve.ts"],
  // The projects hk.pkl's `tsc` step checks; knip does not read hk.pkl.
  "typescript": { "config": ["tsconfig.json", "functions/tsconfig.json", "tools/tsconfig.json"] },
  // serve.ts shells out to the system openssl for its certificate, and the package.json scripts
  // run hk, which mise installs; neither is an npm binary.
  "ignoreBinaries": ["hk", "openssl"],
  // From hk.pkl, which knip does not read: `astro check` loads @astrojs/check, and ESLint loads
  // eslint-formatter-gha by name from `--format gha`.
  "ignoreDependencies": ["@astrojs/check", "eslint-formatter-gha"],
  // tools/lint/anti-slop/shared is vendored upstream source (see its VENDOR.md).
  "ignore": ["tools/lint/anti-slop/shared/**"],
}
